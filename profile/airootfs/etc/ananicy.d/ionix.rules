# Ionix ananicy-cpp rules
# Give the Hyprland compositor and critical desktop components higher priority
# so they are never starved by CPU-bound workloads.

# Compositor — must never be starved for smooth input + rendering
{"name": "Hyprland", "type": "LowLatency_RT"}

# Panel and shell
{"name": "hyprpanel", "type": "LowLatency_RT"}
{"name": "ags", "type": "LowLatency_RT"}
{"name": "gjs", "type": "LowLatency_RT"}

# Wallpaper daemon
{"name": "awww-daemon", "type": "BG_Nice"}

# Lock screen
{"name": "hyprlock", "type": "LowLatency_RT"}

# PipeWire audio — keep audio glitch-free
{"name": "pipewire", "type": "LowLatency_RT"}
{"name": "wireplumber", "type": "LowLatency_RT"}
{"name": "pipewire-pulse", "type": "LowLatency_RT"}
