{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#1a1025",
          "foreground": "#c084fc",
          "leading_diamond": "\ue0c5",
          "options": {
            "macos": "mac"
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} \ue0b1",
          "trailing_diamond": "\ue0b0",
          "type": "os"
        },
        {
          "background": "#1a1025",
          "foreground": "#c4b5fd",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "#2d2d3f",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#2ecc71{{end}}",
            "{{if eq \"Discharging\" .State.String}}#f39c12{{end}}",
            "{{if eq \"Full\" .State.String}}#7c3aed{{end}}"
          ],
          "foreground": "#e2d9f3",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 \ueb2d ",
          "type": "battery"
        },
        {
          "background": "#7c3aed",
          "foreground": "#e2d9f3",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": " \ue0b1 "
          },
          "style": "powerline",
          "template": " \ue5ff {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#9b59b6",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f39c12{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#e74c3c{{ end }}",
            "{{ if gt .Ahead 0 }}#1abc9c{{ end }}",
            "{{ if gt .Behind 0 }}#c084fc{{ end }}"
          ],
          "foreground": "#0f0a18",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#0f0a18{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#e2d9f3{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#2ecc71",
          "foreground": "#0f0a18",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "#f39c12",
          "foreground": "#0f0a18",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf0e7 ",
          "type": "root"
        },
        {
          "background": "#1abc9c",
          "foreground": "#0f0a18",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf308 {{.Context}} :: {{if .Namespace}}{{.Namespace}}{{else}}default{{end}} ",
          "type": "kubectl"
        },
        {
          "background": "#2ecc71",
          "background_templates": [
            "{{ if gt .Code 0 }}#e74c3c{{ end }}"
          ],
          "foreground": "#e2d9f3",
          "leading_diamond": "<transparent,background>\ue0b0</>",
          "options": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": " \uea6c ",
          "trailing_diamond": "\ue0b0",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#a855f7",
          "style": "plain",
          "template": "\u279c ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
