GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Ionix"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 ionix.desktop=hyprland"
GRUB_CMDLINE_LINUX=""

# Disable os-prober: it requires an X display and is not needed for single-boot installs.
# Enable it manually after install if you need dual-boot detection.
GRUB_DISABLE_OS_PROBER=true

GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_THEME="/boot/grub/themes/ionix/theme.txt"
GRUB_BACKGROUND="/boot/grub/themes/ionix/background.png"
GRUB_GFXMODE="1920x1080,auto"
GRUB_GFXPAYLOAD_LINUX=keep
