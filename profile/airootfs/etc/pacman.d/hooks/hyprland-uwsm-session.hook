[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = hyprland

[Action]
Description = Replacing Hyprland session with UWSM-wrapped version...
When = PostTransaction
Depends = coreutils
Exec = /usr/bin/bash -c 'printf "[Desktop Entry]\nName=Hyprland\nComment=An intelligent dynamic tiling Wayland compositor\nExec=uwsm start -- Hyprland\nType=Application\n" > /usr/share/wayland-sessions/hyprland.desktop'
