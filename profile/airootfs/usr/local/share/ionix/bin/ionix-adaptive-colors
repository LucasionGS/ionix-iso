#!/usr/bin/env bash
# Ionix — Adaptive colours
#
# Derives a full Ionix palette from the wallpaper awww is currently showing and
# renders the active theme's templates with it.
#
# A theme opts in by putting `export USE_ADAPTIVE_COLORS=true` in its `install`
# file (see /usr/local/share/ionix/styler/install-default). This script exits 0
# and does nothing when the active theme has not opted in, so every caller —
# ionix-wallpaper, ionix-cycle-wallpaper, ionixtheme, the login init.sh — can
# invoke it unconditionally without knowing anything about themes.
#
# Nothing here is fatal. A missing wallpaper, a missing matugen, a template with
# a typo in it: every one of those leaves the theme's own static files in place
# and exits 0, because a desktop with last week's colours beats a desktop with
# no colours.
#
# Usage: ionix-adaptive-colors [OPTIONS]
#   --force            ignore the stamp and regenerate
#   --wallpaper PATH   derive from this image instead of asking awww
#   --print            print the derived palette as JSON and exit, writing nothing
#   --clean            remove all generated output and exit
#   -q, --quiet        suppress progress output
#   -h, --help         show this help

# Deliberately not -e: the whole point of this script is that every failure is a
# soft one that falls back to the theme's static files.
set -uo pipefail

# Bump to invalidate every stamp on disk — do this whenever the derivation or
# the token grammar changes, or old output would survive a package upgrade.
GEN_VERSION=1

# Overridable so the tree can be exercised from a git checkout before it is
# installed; nothing on a running system sets it.
STYLER_DIR="${IONIX_STYLER_DIR:-/usr/local/share/ionix/styler}"
IONIX_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ionix"
OUT_DIR="$IONIX_DIR/adaptive-colors"
PALETTE_JSON="$IONIX_DIR/adaptive-colors.json"
STAMP="$OUT_DIR/.stamp"
LOCK="$OUT_DIR/.lock"
FALLBACK_WALL=/usr/local/share/ionix/wallpaper.png

# install-default calls msg/err, so both have to exist before it is sourced in
# the re-link step below.
msg()  { [[ -n "${QUIET:-}" ]] || printf '\033[1;35m[ionix]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[ionix]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[ionix]\033[0m %s\n' "$*" >&2; }
# Every error path is a clean no-op, never a failure exit — see the header.
die0() { warn "$*"; exit 0; }

usage() { sed -n '/^# Usage:/,/^#   -h/s/^#\{1,2\} \{0,1\}//p' "$0"; }

# ── Arguments ───────────────────────────────────────────────

FORCE=; WALL_ARG=; PRINT_ONLY=; CLEAN=; QUIET=

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force)      FORCE=1 ;;
        --wallpaper)  WALL_ARG="${2-}"; shift ;;
        --print)      PRINT_ONLY=1 ;;
        --clean)      CLEAN=1 ;;
        -q|--quiet)   QUIET=1 ;;
        -h|--help)    usage; exit 0 ;;
        *)            err "Unknown option: $1"; usage >&2; exit 2 ;;
    esac
    shift
done

if [[ -n "$CLEAN" ]]; then
    rm -rf "$OUT_DIR" "$PALETTE_JSON"
    msg "adaptive: removed generated colours"
    exit 0
fi

# ── Guards ──────────────────────────────────────────────────

# A theme with a wallpaper/ directory makes ionixtheme call ionix-wallpaper,
# which calls us, which re-runs the installers. Break the cycle at the top.
[[ -n "${IONIX_ADAPTIVE_RUNNING:-}" ]] && exit 0
export IONIX_ADAPTIVE_RUNNING=1

# ── Which theme, and does it want us? ───────────────────────

# ionixtheme exports THEME_DIR/THEME_NAME before calling us, so on a theme
# switch we read the *incoming* theme rather than the stale current-theme file.
theme_name="${THEME_NAME:-}"
if [[ -z "$theme_name" && -f "$IONIX_DIR/current-theme" ]]; then
    theme_name="$(< "$IONIX_DIR/current-theme")"
fi
theme_name="${theme_name//[[:space:]]/}"

# No theme yet — the live ISO, or a fresh install before the first switch.
[[ -n "$theme_name" && "$theme_name" != none ]] || exit 0

theme_dir="${THEME_DIR:-$STYLER_DIR/themes/$theme_name}"
[[ -d "$theme_dir" ]] || exit 0
# No install file at all means the theme cannot have opted in.
[[ -f "$theme_dir/install" ]] || exit 0

# The knobs a theme may set. Read back by name so nothing else the install file
# happens to define can reach this process.
KNOB_NAMES=(
    USE_ADAPTIVE_COLORS
    IONIX_ADAPTIVE_SCHEME IONIX_ADAPTIVE_MODE IONIX_ADAPTIVE_SOURCE_INDEX
    IONIX_ADAPTIVE_CONTRAST IONIX_ADAPTIVE_LIGHTNESS_DARK IONIX_ADAPTIVE_FALLBACK_COLOR
    IONIX_ADAPTIVE_SURFACE_PALETTE IONIX_ADAPTIVE_ACCENT_PALETTE
    IONIX_ADAPTIVE_TONE_BGDEEP IONIX_ADAPTIVE_TONE_BGWINDOW IONIX_ADAPTIVE_TONE_BGCARD
    IONIX_ADAPTIVE_TONE_HOVER IONIX_ADAPTIVE_TONE_BORDER IONIX_ADAPTIVE_TONE_MUTED
    IONIX_ADAPTIVE_TONE_ACCENT_DEEP IONIX_ADAPTIVE_TONE_ACCENT
    IONIX_ADAPTIVE_TONE_ACCENT_BRIGHT IONIX_ADAPTIVE_TONE_ACCENT_LIGHT
    IONIX_ADAPTIVE_TONE_TEXT
    IONIX_ADAPTIVE_ANSI IONIX_ADAPTIVE_OUTPUT IONIX_ADAPTIVE_MIN_INTERVAL
)

# Sourced in a clean subshell with an empty environment: a third-party theme's
# install file is arbitrary shell, and a stray `export PATH=` or `cd` in it must
# not reach the rest of this script. Its contract is "no side effects at source
# time" — the same contract ionixtheme already relies on to pick up function
# overrides — but this makes a breach cheap instead of confusing.
eval "$(
    env -i HOME="$HOME" PATH="$PATH" USER="${USER:-}" \
        THEME_DIR="$theme_dir" THEME_NAME="$theme_name" \
        bash --noprofile --norc -c '
            source "$THEME_DIR/install" >/dev/null 2>&1
            for v in '"${KNOB_NAMES[*]}"'; do
                printf "%s=%q\n" "$v" "${!v-}"
            done
        ' 2>/dev/null
)"

# Not an adaptive theme. Silent — every caller invokes us unconditionally.
[[ "${USE_ADAPTIVE_COLORS:-}" == true ]] || exit 0

tpl_dir="$theme_dir/adaptive"
[[ -d "$tpl_dir" ]] || die0 "$theme_name: USE_ADAPTIVE_COLORS is set but $tpl_dir is missing"

# Only now, so a user on a plain theme never gets an adaptive-colors directory
# created behind their back. A keybind press racing the wallpaper cycler would
# otherwise interleave two renders into the same output; whoever holds the lock
# is producing output at least as new as ours, so losing is a no-op, not a
# failure.
if [[ -z "$PRINT_ONLY" ]] && command -v flock &>/dev/null; then
    mkdir -p "$OUT_DIR"
    exec {lock_fd}>"$LOCK" || true
    if [[ -n "${lock_fd:-}" ]]; then
        flock -n "$lock_fd" || exit 0
    fi
fi

command -v matugen &>/dev/null || die0 "matugen not installed — keeping the theme's static colours"
command -v jq      &>/dev/null || die0 "jq not installed — keeping the theme's static colours"

scheme="${IONIX_ADAPTIVE_SCHEME:-scheme-content}"
mode="${IONIX_ADAPTIVE_MODE:-dark}"
# Mandatory. Without it matugen 4 tries to prompt for a source colour and hard
# fails with "a terminal was not detected" — which is every call site but a
# hand-typed one.
source_index="${IONIX_ADAPTIVE_SOURCE_INDEX:-0}"
contrast="${IONIX_ADAPTIVE_CONTRAST:-0}"
lightness_dark="${IONIX_ADAPTIVE_LIGHTNESS_DARK:-0}"
fallback_color="${IONIX_ADAPTIVE_FALLBACK_COLOR:-#9b59b6}"
surface_palette="${IONIX_ADAPTIVE_SURFACE_PALETTE:-secondary}"
accent_palette="${IONIX_ADAPTIVE_ACCENT_PALETTE:-primary}"
ansi_policy="${IONIX_ADAPTIVE_ANSI:-static}"
min_interval="${IONIX_ADAPTIVE_MIN_INTERVAL:-0}"

# ── Which wallpaper? ────────────────────────────────────────

# awww query prints "': eDP-1: 1920x1200, scale: 1, currently displaying: image: /path'"
# — note the leading ": " before the output name.
awww_image_for() {
    local out="$1"
    awww query 2>/dev/null |
        sed -n "s|^:[[:space:]]*${out}:.*currently displaying: image: ||p" | head -n1
}

resolve_wallpaper() {
    local p out

    [[ -n "$WALL_ARG" ]] && { printf '%s\n' "$WALL_ARG"; return 0; }

    if command -v awww &>/dev/null; then
        # Outputs can carry different images — ionix-cycle-wallpaper sets each
        # one separately — so one of them has to win. The pinned output, else
        # whichever monitor has focus, else the first line.
        out="${IONIX_ADAPTIVE_OUTPUT:-}"
        if [[ -z "$out" ]] && command -v hyprctl &>/dev/null; then
            out="$(hyprctl -j monitors 2>/dev/null | jq -r '.[]|select(.focused)|.name' 2>/dev/null | head -n1)"
        fi
        if [[ -n "$out" ]]; then
            p="$(awww_image_for "$out")"
            [[ -n "$p" && -r "$p" ]] && { printf '%s\n' "$p"; return 0; }
        fi
        p="$(awww query 2>/dev/null | sed -n 's|.*currently displaying: image: ||p' | head -n1)"
        [[ -n "$p" && -r "$p" ]] && { printf '%s\n' "$p"; return 0; }
    fi

    # awww's own cache, for when the daemon is not answering yet — the version
    # is part of the path, so find the newest file rather than guessing it. The
    # record is NUL-separated and the image path is its last field.
    p="$(find "${XDG_CACHE_HOME:-$HOME/.cache}/awww" -type f -printf '%T@ %p\n' 2>/dev/null |
         sort -rn | head -n1 | cut -d' ' -f2-)"
    if [[ -n "$p" && -r "$p" ]]; then
        p="$(tr '\0' '\n' < "$p" 2>/dev/null | tail -n1)"
        [[ -n "$p" && -r "$p" ]] && { printf '%s\n' "$p"; return 0; }
    fi

    # The pool ionix-wallpaper maintains.
    p="$(find "$IONIX_DIR/.wallpapers_active" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
            2>/dev/null | sort | head -n1)"
    [[ -n "$p" ]] && { printf '%s\n' "$p"; return 0; }

    # The theme's own wallpaper, then the one the ISO ships.
    p="$(find "$theme_dir/wallpaper" -maxdepth 1 -type f 2>/dev/null | sort | head -n1)"
    [[ -n "$p" ]] && { printf '%s\n' "$p"; return 0; }
    [[ -r "$FALLBACK_WALL" ]] && { printf '%s\n' "$FALLBACK_WALL"; return 0; }

    return 1
}

wall="$(resolve_wallpaper)" || die0 "no wallpaper found — keeping the theme's static colours"
[[ -r "$wall" ]] || die0 "wallpaper not readable: $wall"

case "${wall,,}" in
    *.png|*.jpg|*.jpeg|*.webp|*.bmp|*.tif|*.tiff) ;;
    *.gif) warn "adaptive: $(basename "$wall") is a gif — matugen may reject it" ;;
    *) die0 "unsupported wallpaper format: $wall" ;;
esac

# ── Has anything actually changed? ──────────────────────────

signature() {
    printf '%s\0' \
        "$GEN_VERSION" "$theme_name" "$wall" "$(stat -c '%Y:%s' "$wall" 2>/dev/null)" \
        "$scheme" "$mode" "$source_index" "$contrast" "$lightness_dark" "$fallback_color" \
        "$surface_palette" "$accent_palette" "$ansi_policy" \
        "${IONIX_ADAPTIVE_TONE_BGDEEP:-}" "${IONIX_ADAPTIVE_TONE_BGWINDOW:-}" \
        "${IONIX_ADAPTIVE_TONE_BGCARD:-}" "${IONIX_ADAPTIVE_TONE_HOVER:-}" \
        "${IONIX_ADAPTIVE_TONE_BORDER:-}" "${IONIX_ADAPTIVE_TONE_MUTED:-}" \
        "${IONIX_ADAPTIVE_TONE_ACCENT_DEEP:-}" "${IONIX_ADAPTIVE_TONE_ACCENT:-}" \
        "${IONIX_ADAPTIVE_TONE_ACCENT_BRIGHT:-}" "${IONIX_ADAPTIVE_TONE_ACCENT_LIGHT:-}" \
        "${IONIX_ADAPTIVE_TONE_TEXT:-}" \
        "$(find "$tpl_dir" -type f -printf '%p:%T@:%s\n' 2>/dev/null | sort)" |
    cksum | tr -d ' '
}

sig="$(signature)"

# Every expected output must exist too — a stamp that survived a half-deleted
# output directory would otherwise paper over it.
outputs_complete() {
    local tpl
    while IFS= read -r tpl; do
        [[ -f "$OUT_DIR/${tpl#"$tpl_dir"/}" ]] || return 1
    done < <(find "$tpl_dir" -type f)
    return 0
}

if [[ -z "$FORCE" && -z "$PRINT_ONLY" && -f "$STAMP" ]]; then
    if [[ "$(< "$STAMP")" == "$sig" ]] && outputs_complete; then
        exit 0
    fi
    # A wallpaper cycler on a short timer would otherwise pay a hyprctl reload —
    # which visibly re-flows every window border — on every tick.
    #
    # Only when the wallpaper was not named on the command line. ionix-wallpaper
    # passes --wallpaper because somebody just picked that image; the cycler does
    # not, because a timer did. Throttling the first would make the picker look
    # broken, which is not what this knob is for.
    if [[ -z "$WALL_ARG" && "$min_interval" -gt 0 ]] 2>/dev/null; then
        age=$(( $(date +%s) - $(stat -c '%Y' "$STAMP" 2>/dev/null || echo 0) ))
        if (( age < min_interval )); then
            msg "adaptive: last run ${age}s ago, below IONIX_ADAPTIVE_MIN_INTERVAL=${min_interval}"
            exit 0
        fi
    fi
fi

# ── Extract ─────────────────────────────────────────────────

matugen_args=(
    image "$wall" -q
    -t "$scheme"
    -m "$mode"
    --source-color-index "$source_index"
    --contrast "$contrast"
    --lightness-dark "$lightness_dark"
    --fallback-color "$fallback_color"
)

# Two passes rather than one because --json takes a single format, and having
# matugen produce the rgb triples is cheaper and less wrong than converting hex
# by hand for GTK's rgba(). ~66ms each; the flags are identical so they cannot
# disagree about the source colour.
raw_hex="$(matugen "${matugen_args[@]}" --json hex 2>/dev/null)" \
    || die0 "matugen failed on $wall — keeping the theme's static colours"
raw_rgb="$(matugen "${matugen_args[@]}" --json rgb 2>/dev/null)" \
    || die0 "matugen failed on $wall — keeping the theme's static colours"
jq -e . >/dev/null 2>&1 <<<"$raw_hex" \
    || die0 "matugen produced no usable JSON for $wall"

# ── Derive ──────────────────────────────────────────────────
#
# NOT from matugen's `colors.surface*` roles, and NOT from its `base16` block:
#   - colors.surface* carries M3's *neutral* chroma (~4-6) and reads grey. The
#     Ionix backgrounds are saturated violet (#0f0a18 is S=41).
#   - base16 is a monochrome ramp of the source colour — its "green" slot comes
#     out near-black — so it is useless as a terminal palette.
# `palettes.<name>.<tone>` under scheme-content is the tonal ladder with the
# wallpaper's own chroma intact, and tones 5/10/20/25/30/50 land almost exactly
# on the hand-tuned Ionix ladder. Tones are CIE L*, so text contrast against the
# backgrounds holds to within 1% whatever hue the wallpaper is.

palette="$(jq -n \
    --argjson h "$raw_hex" --argjson r "$raw_rgb" \
    --arg mode   "$mode" \
    --arg sp     "$surface_palette" \
    --arg ap     "$accent_palette" \
    --arg ansi   "$ansi_policy" \
    --arg source "$wall" \
    --arg t_deep    "${IONIX_ADAPTIVE_TONE_BGDEEP:-5}" \
    --arg t_win     "${IONIX_ADAPTIVE_TONE_BGWINDOW:-10}" \
    --arg t_card    "${IONIX_ADAPTIVE_TONE_BGCARD:-20}" \
    --arg t_hover   "${IONIX_ADAPTIVE_TONE_HOVER:-25}" \
    --arg t_border  "${IONIX_ADAPTIVE_TONE_BORDER:-30}" \
    --arg t_muted   "${IONIX_ADAPTIVE_TONE_MUTED:-50}" \
    --arg t_accdeep "${IONIX_ADAPTIVE_TONE_ACCENT_DEEP:-40}" \
    --arg t_acc     "${IONIX_ADAPTIVE_TONE_ACCENT:-50}" \
    --arg t_accb    "${IONIX_ADAPTIVE_TONE_ACCENT_BRIGHT:-60}" \
    --arg t_accl    "${IONIX_ADAPTIVE_TONE_ACCENT_LIGHT:-70}" \
    --arg t_text    "${IONIX_ADAPTIVE_TONE_TEXT:-80}" \
'
# "rgb(14, 15, 33)" -> "14,15,33". Unspaced because IoExplorer parses the
# theme.* values back out of its own stylesheet and writes them that way.
def strip: ltrimstr("rgb(") | rtrimstr(")") | gsub(", *"; ",");
# A tone off a tonal palette. With -m dark/light the palette entries are flat.
def sl($p; $t): {
    hex: ($h.palettes[$p][$t].color),
    rgb: ($r.palettes[$p][$t].color | strip)
};
# A named M3 role. These stay nested by mode even when one is requested.
def rl($k): {
    hex: ($h.colors[$k][$mode].color),
    rgb: ($r.colors[$k][$mode].color | strip)
};
# A fixed colour. Both forms spelled out — jq has no hex parser worth writing.
def L($hex; $rgb): { hex: $hex, rgb: $rgb };

  {
    bgDeep:       sl($sp; $t_deep),
    bgWindow:     sl($sp; $t_win),
    bgCard:       sl($sp; $t_card),
    hover:        sl($sp; $t_hover),
    border:       sl($sp; $t_border),
    muted:        sl($sp; $t_muted),
    accentDeep:   sl($ap; $t_accdeep),
    accent:       sl($ap; $t_acc),
    accentBright: sl($ap; $t_accb),
    accentLight:  sl($ap; $t_accl),
    text:         sl($ap; $t_text),
    textBright:   rl("on_surface"),

    # Semantics are never derived. A terminal error is red on every wallpaper,
    # and a battery-low warning that turned green with the desktop would be a
    # bug, not a theme.
    green:  L("#2ecc71"; "46,204,113"),
    orange: L("#f39c12"; "243,156,18"),
    red:    L("#e74c3c"; "231,76,60"),
    cyan:   L("#48dbfb"; "72,219,251")
  }
  | . + {
    link:   .accentDeep,
    # Hyprland shadows: the deepest background, so the shadow reads as more of
    # the same surface rather than as neutral soot.
    shadow: .bgDeep
  }
  | . + (
    # The 16 ANSI slots. Under the default `static` policy only the structural
    # ones follow the wallpaper (0/7/8/15 are backgrounds and text) and the hues
    # stay put, because a terminal palette is a semantic contract with every
    # program that draws in it. `tinted` lets the violet ramp follow the accent.
    {
      ansi0:  .bgWindow, ansi7:  .text,
      ansi8:  .bgCard,   ansi15: .textBright,
      ansi1:  .red,      ansi9:  L("#ff6b6b"; "255,107,107"),
      ansi2:  .green,    ansi10: L("#55efc4"; "85,239,196"),
      ansi3:  .orange,   ansi11: L("#feca57"; "254,202,87"),
      ansi6:  L("#1abc9c"; "26,188,156"),
      ansi14: .cyan
    }
    + (if $ansi == "tinted" then {
         ansi4:  .accentDeep,   ansi12: .accentBright,
         ansi5:  .accent,       ansi13: .accentLight
       } else {
         ansi4:  L("#7c3aed"; "124,58,237"), ansi12: L("#a855f7"; "168,85,247"),
         ansi5:  L("#9b59b6"; "155,89,182"), ansi13: L("#c084fc"; "192,132,252")
       } end)
  )
  | { source: $source, sourceColor: $h.colors.source_color[$mode].color, slots: . }
')" || die0 "palette derivation failed"

[[ -n "$palette" ]] || die0 "palette derivation produced nothing"

if [[ -n "$PRINT_ONLY" ]]; then
    printf '%s\n' "$palette"
    exit 0
fi

# ── Render ──────────────────────────────────────────────────

mkdir -p "$OUT_DIR"
# Inside OUT_DIR on purpose: mv is then a same-filesystem rename, which is
# atomic. A temp dir in /tmp would make mv a copy, briefly truncating a file a
# running shell may be reading.
tmp="$(mktemp -d "$OUT_DIR/.tmp.XXXXXX")" || die0 "cannot create a temp directory in $OUT_DIR"
trap 'rm -rf "$tmp"' EXIT

# One sed program for the whole run: three token forms for every slot. Alpha is
# the template author's business — `rgba({{bgDeep.rgb}}, 0.74)` — otherwise the
# token set would need one variant per opacity anyone ever wants.
sed_program="$(jq -r '
    .slots | to_entries[] |
    "s|{{\(.key)}}|\(.value.hex)|g",
    "s|{{\(.key).raw}}|\(.value.hex | ltrimstr("#"))|g",
    "s|{{\(.key).rgb}}|\(.value.rgb)|g"
' <<<"$palette")" || die0 "could not build the substitution program"

changed=()
while IFS= read -r tpl; do
    rel="${tpl#"$tpl_dir"/}"
    section="${rel%%/*}"

    # The static sibling is the fallback everything else in this script falls
    # back *to*, so a template without one is a theme packaging error.
    if [[ ! -f "$theme_dir/$rel" ]]; then
        warn "adaptive: $rel has no static counterpart at $theme_dir/$rel, skipping"
        continue
    fi

    mkdir -p "$tmp/$section"
    if ! sed "$sed_program" "$tpl" > "$tmp/$rel" 2>/dev/null; then
        warn "adaptive: $rel failed to render"
        continue
    fi

    # A surviving {{...}} is a typo or a slot we do not emit. Shipping a config
    # with a literal token in it is worse than shipping the static file.
    if grep -q '{{[A-Za-z]' "$tmp/$rel"; then
        warn "adaptive: $rel has unresolved tokens: $(grep -o '{{[^}]*}}' "$tmp/$rel" | sort -u | tr '\n' ' ')"
        continue
    fi

    mkdir -p "$OUT_DIR/$section"
    if ! cmp -s "$tmp/$rel" "$OUT_DIR/$rel"; then
        mv -f "$tmp/$rel" "$OUT_DIR/$rel" && changed+=("$section")
    fi
done < <(find "$tpl_dir" -type f | sort)

if jq . <<<"$palette" > "$tmp/palette.json" 2>/dev/null; then
    mv -f "$tmp/palette.json" "$PALETTE_JSON"
fi
printf '%s\n' "$sig" > "$STAMP"

[[ ${#changed[@]} -gt 0 ]] || exit 0
mapfile -t changed < <(printf '%s\n' "${changed[@]}" | sort -u)
msg "adaptive: $(basename "$wall") → ${changed[*]}"

# ── Re-link and reload ──────────────────────────────────────
#
# Rewriting a symlink's *target* is not enough. IoExplorer watches the
# ~/.config/ioexplorer *directory* for moves, and Quickshell's FileView watches
# an inode — neither sees a target rewritten underneath it. Re-running the
# section installer recreates the symlink, which is the event they do see, and
# fires that section's own reload nudge, so the destination paths stay defined
# in exactly one place: install-default.

# The styler is about to run every installer itself.
[[ -n "${IONIX_ADAPTIVE_FROM_STYLER:-}" ]] && exit 0
[[ -f "$STYLER_DIR/install-default" ]] || exit 0

(
    export THEME_DIR="$theme_dir" THEME_NAME="$theme_name"
    # The installers narrate; on a wallpaper change nobody asked for a report.
    msg() { :; }

    source "$STYLER_DIR/install-default"
    source "$theme_dir/install"

    for section in "${changed[@]}"; do
        # ionix_install_wallpaper calls ionix-wallpaper, which calls us back.
        [[ "$section" == wallpaper ]] && continue
        declare -F "ionix_install_$section" &>/dev/null && "ionix_install_$section"
    done
) || warn "adaptive: re-link failed — the symlinks still point at the regenerated files"

exit 0
