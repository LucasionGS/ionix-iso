#!/usr/bin/env bash
# Ionix Post-Install Script
# Called by Calamares shellprocess inside the installed system chroot.
# This runs AFTER the user has been created and packages installed.

set -euo pipefail

# Choices from the installer's Personalize page and the users page, passed in by
# shellprocess.conf from Calamares' GlobalStorage. Defaults keep a run without
# them (say, by hand) behaving as before.
IONIX_THEME="${IONIX_THEME:-ionix}"          # ionixtheme name
IONIX_BAR="${IONIX_BAR:-default}"            # default | top | bottom | left | right
IONIX_AUTOLOGIN="${IONIX_AUTOLOGIN:-no}"     # yes: skip the lock screen at session start

# Find the first non-root user with UID >= 1000
NEWUSER=$(awk -F: '$3 >= 1000 && $1 != "nobody" && $1 != "liveuser" {print $1; exit}' /etc/passwd)

if [[ -n "$NEWUSER" ]]; then
    # Set fish as default shell
    chsh -s /usr/bin/fish "$NEWUSER" 2>/dev/null || true

    # Ensure user home has correct ownership
    if [[ -d "/home/$NEWUSER" ]]; then
        chown -R "$NEWUSER:$NEWUSER" "/home/$NEWUSER"
    fi
fi

# Set fish as root shell too
chsh -s /usr/bin/fish root 2>/dev/null || true

# How the installed system starts. The tty1 autologin drop-in is written either
# way: it is what the two non-greeter modes run.
#
# "Log in automatically" on the users page picks `autologin` (straight to the
# desktop). Otherwise the default is the greeter: greetd → cage → ionix-greeter
# asks for username and password. `ionix-login-mode locked` is the old
# behaviour, a session that opens behind ionix-lock.
mkdir -p /etc/ionix
if [[ -n "$NEWUSER" ]]; then
    mkdir -p /etc/systemd/system/getty@tty1.service.d
    cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf << AUTOLOGIN
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\u' --noclear --autologin $NEWUSER - \$TERM
AUTOLOGIN
fi
if [[ "$IONIX_AUTOLOGIN" == "yes" ]]; then
    ionix-login-mode autologin
else
    # A machine that somehow lacks greetd/cage keeps the old locked session.
    ionix-login-mode greeter || ionix-login-mode locked
fi

# Unlock the GNOME keyring with the login password, so apps using libsecret
# (browsers, the calendar token, ssh keys) never ask for it again after boot.
# The greeter's password goes through greetd's PAM stack: the auth line keeps
# it, the session line starts gnome-keyring-daemon and unlocks the `login`
# keyring with it, creating that keyring on an account that has none yet.
# Hyprland's own `gnome-keyring-daemon --start` then attaches to that daemon.
# passwd gets the password line so a password change re-encrypts the keyring
# too; otherwise the two drift apart and the prompt comes back.
#
# Only a password login can do this. Autologin and a fingerprint at the
# greeter hand PAM no password, so the keyring stays locked until first use.
# Edited here rather than shipped in the ISO overlay: both files belong to
# packages (greetd, pambase), and pacman would refuse to install over them.
pam_add_after() {  # <file> <line to add> <awk regex of the line to add it after>
    local f=$1 line=$2 after=$3
    [[ -f "$f" ]] || return 0
    grep -qF -- "$line" "$f" && return 0
    awk -v line="$line" -v after="$after" '
        { print }
        !done && $0 ~ after { print line; done = 1 }
        END { if (!done) print line }
    ' "$f" > "$f.ionix" && cat "$f.ionix" > "$f" && rm -f "$f.ionix"
}
pam_add_after /etc/pam.d/greetd "auth       optional     pam_gnome_keyring.so" '^auth[[:space:]]+include'
pam_add_after /etc/pam.d/greetd "session    optional     pam_gnome_keyring.so auto_start" '^session[[:space:]]+include'
pam_add_after /etc/pam.d/passwd "password   optional     pam_gnome_keyring.so" '^password[[:space:]]'

# Desktop theme and bar position from the Personalize page. ionixtheme needs a
# running session (the adaptive theme reads the wallpaper), so the theme is only
# queued here and ionix-first-login applies it; the bar position is a plain key
# in the shell's settings file and can be written now. "ionix" and "default" are
# what a fresh account already gets, so they write nothing.
if [[ -n "$NEWUSER" && -d "/home/$NEWUSER" ]]; then
    if [[ "$IONIX_THEME" != "ionix" && -d "/usr/local/share/ionix/styler/themes/$IONIX_THEME" ]]; then
        install -d -o "$NEWUSER" -g "$NEWUSER" "/home/$NEWUSER/.config/ionix"
        printf '%s\n' "$IONIX_THEME" > "/home/$NEWUSER/.config/ionix/pending-theme"
        chown "$NEWUSER:$NEWUSER" "/home/$NEWUSER/.config/ionix/pending-theme"
    fi
    case "$IONIX_BAR" in
        top|bottom|left|right)
            qs_dir="/home/$NEWUSER/.config/quickshell/ionix"
            install -d -o "$NEWUSER" -g "$NEWUSER" "/home/$NEWUSER/.config/quickshell" "$qs_dir"
            printf '{\n  "bar": {\n    "position": "%s"\n  }\n}\n' "$IONIX_BAR" > "$qs_dir/settings.json"
            chown "$NEWUSER:$NEWUSER" "$qs_dir/settings.json"
            ;;
    esac
fi

# Enable [multilib]. The ISO ships lib32 graphics and audio libraries (for Steam
# and Wine), but the stock pacman.conf leaves multilib commented out, so without
# this those packages could never be updated alongside their 64-bit halves.
if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
    sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
fi

# Enable systemd services for the installed system
systemctl enable NetworkManager.service 2>/dev/null || true
systemctl enable power-profiles-daemon.service 2>/dev/null || true
systemctl enable bluetooth.service 2>/dev/null || true
systemctl enable ananicy-cpp.service 2>/dev/null || true

# Remove live-session-only artifacts
rm -f /etc/sudoers.d/10-ionix
rm -f /usr/share/applications/ionix-install.desktop
rm -f /etc/motd

# Remove the live user
userdel -r liveuser 2>/dev/null || true

# Remove live-session systemd services
# systemd-firstboot is masked on the live medium so it never prompts for a
# timezone on the console; the installed system gets locale/timezone/hostname
# from Calamares, so unmask it rather than leaving the live mask behind.
rm -f /etc/systemd/system/systemd-firstboot.service
rm -f /etc/systemd/system/choose-mirror.service
rm -f /etc/systemd/system/etc-pacman.d-gnupg.mount
rm -f /etc/systemd/system/pacman-init.service
rm -f /etc/systemd/system/multi-user.target.wants/choose-mirror.service
rm -f /etc/systemd/system/multi-user.target.wants/etc-pacman.d-gnupg.mount
rm -f /etc/systemd/system/multi-user.target.wants/pacman-init.service

# Remove archiso-specific hooks
rm -f /etc/pacman.d/hooks/uncomment-mirrors.hook
rm -f /etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook

# Ensure kernel image is in /boot (archiso squashfs doesn't include it)
KVER=$(ls /usr/lib/modules/ | sort -V | tail -1)
if [[ ! -f /boot/vmlinuz-linux && -f "/usr/lib/modules/$KVER/vmlinuz" ]]; then
    install -Dm644 "/usr/lib/modules/$KVER/vmlinuz" /boot/vmlinuz-linux
fi

# The live ISO keeps its journal in RAM (archiso's volatile-storage.conf), and
# unpackfs copied that onto the target too, so an installed system lost every
# log on reboot. Without it journald's default Storage=auto persists to
# /var/log/journal, which the systemd package ships.
rm -f /etc/systemd/journald.conf.d/volatile-storage.conf

# Remove archiso mkinitcpio config and replace the archiso-only preset
# with a standard one before regenerating. Without this, mkinitcpio -P
# would have no presets to build and leave the archiso initramfs (with
# memdisk/archiso hooks) on the installed system, preventing boot.
rm -f /etc/mkinitcpio.conf.d/archiso.conf
cat > /etc/mkinitcpio.d/linux.preset << 'PRESET'
PRESETS=('default' 'fallback')
ALL_kver='/boot/vmlinuz-linux'
default_config='/etc/mkinitcpio.conf'
default_image='/boot/initramfs-linux.img'
fallback_config='/etc/mkinitcpio.conf'
fallback_image='/boot/initramfs-linux-fallback.img'
fallback_options='-S autodetect'
PRESET

# Regenerate initramfs with default config
mkinitcpio -P

# Remove ionix local repo from pacman.conf (no longer needed after install)
sed -i '/^\[ionix\]/,/^Server/d' /etc/pacman.conf 2>/dev/null || true

# Initialize and populate the pacman keyring so the system is ready for updates
pacman-key --init
pacman-key --populate archlinux
pacman -Sy --noconfirm archlinux-keyring 2>/dev/null || true

# Set proper sudo (wheel group requires password)
cat > /etc/sudoers.d/10-wheel <<'SUDOERS'
%wheel ALL=(ALL:ALL) ALL
SUDOERS
chmod 440 /etc/sudoers.d/10-wheel

# GPU detection: remove NVIDIA packages if no NVIDIA GPU present,
# or add nvidia kernel parameters if NVIDIA GPU is detected
if lspci | grep -qi 'nvidia'; then
    # NVIDIA GPU detected — enable DRM modesetting for Wayland
    mkdir -p /etc/modprobe.d
    echo 'options nvidia_drm modeset=1 fbdev=1' > /etc/modprobe.d/nvidia.conf
    # Ensure nvidia modules load early
    sed -i 's/^MODULES=(\(.*\))/MODULES=(\1 nvidia nvidia_modeset nvidia_uvm nvidia_drm)/' /etc/mkinitcpio.conf
    mkinitcpio -P
else
    # No NVIDIA GPU — remove NVIDIA packages to save space
    pacman -Rns --noconfirm nvidia-open nvidia-utils lib32-nvidia-utils egl-wayland libva-nvidia-driver 2>/dev/null || true
fi

# Fingerprint: wire PAM up only where there is actually a sensor. Detection
# reads the hardware tables libfprint ships, so it works here in the chroot
# with no D-Bus and no running fprintd. fprintd itself stays installed either
# way — it is D-Bus activated, so it costs nothing idle, and leaving it means a
# USB reader plugged in later needs only `sudo ionix-fingerprint enable`.
if /usr/local/bin/ionix-fingerprint detect --quiet 2>/dev/null; then
    /usr/local/bin/ionix-fingerprint enable --quiet || true
fi

# Remove bin files we added to /usr/local/bin during the live session
rm -f /usr/local/bin/ionix-install
rm -f /usr/local/bin/grub-install
rm -f /usr/local/bin/ionix-post-install


echo "Ionix post-install completed."
