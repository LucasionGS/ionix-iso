#!/usr/bin/env bash
# Ionix Session Selector
# Displays a TTY menu to choose between desktop sessions.
# Outputs the session name (hyprland, gnome, or kde) to stdout.

LAST_SESSION_FILE="$HOME/.config/ionix/last-session"
DEFAULT="hyprland"

if [[ -f "$LAST_SESSION_FILE" ]]; then
    DEFAULT=$(cat "$LAST_SESSION_FILE")
fi

if [[ "$DEFAULT" != "hyprland" && "$DEFAULT" != "gnome" && "$DEFAULT" != "kde" ]]; then
    DEFAULT="hyprland"
fi

# Build display strings with default marker
if [[ "$DEFAULT" == "hyprland" ]]; then
              OPT1="  1) Hyprland  \e[35m(default)\e[0m"
              OPT2="  2) GNOME"
              OPT3="  3) KDE Plasma"
elif [[ "$DEFAULT" == "gnome" ]]; then
              OPT1="  1) Hyprland"
              OPT2="  2) GNOME     \e[35m(default)\e[0m"
              OPT3="  3) KDE Plasma"
else
              OPT1="  1) Hyprland"
              OPT2="  2) GNOME"
              OPT3="  3) KDE Plasma \e[35m(default)\e[0m"
fi

echo "" >&2
echo -e "  \e[35m╔══════════════════════════════╗\e[0m" >&2
echo -e "  \e[35m║\e[0m     Welcome to \e[1;35mIonix\e[0m        \e[35m║\e[0m" >&2
echo -e "  \e[35m╠══════════════════════════════╣\e[0m" >&2
echo -e "  \e[35m║\e[0m  Select desktop session:     \e[35m║\e[0m" >&2
echo -e "  \e[35m║\e[0m                              \e[35m║\e[0m" >&2
echo -e "  \e[35m║\e[0m${OPT1}            \e[35m║\e[0m" >&2
echo -e "  \e[35m║\e[0m${OPT2}            \e[35m║\e[0m" >&2
echo -e "  \e[35m║\e[0m${OPT3}       \e[35m║\e[0m" >&2
echo -e "  \e[35m║\e[0m                              \e[35m║\e[0m" >&2
echo -e "  \e[35m╚══════════════════════════════╝\e[0m" >&2
echo "" >&2
read -t 5 -n 1 -p "  Choice [1/3] (auto-start in 5s): " choice
echo "" >&2

case "$choice" in
    1) SESSION="hyprland" ;;
    2) SESSION="gnome" ;;
    3) SESSION="kde" ;;
    "") SESSION="$DEFAULT" ;;
    *) SESSION="$DEFAULT" ;;
esac

mkdir -p "$(dirname "$LAST_SESSION_FILE")"
echo "$SESSION" > "$LAST_SESSION_FILE"
echo "$SESSION"
