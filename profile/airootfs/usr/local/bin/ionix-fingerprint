#!/usr/bin/env bash
# Ionix fingerprint integration.
#
# Fingerprint support is opt-in per machine. The ISO always ships fprintd, but
# nothing is wired into PAM until a supported sensor is actually found, so a
# laptop with a reader comes up ready and a desktop without one is untouched.
# ionix-post-install calls `detect` and then `enable` inside the target chroot;
# everything here also works by hand afterwards, which is what makes a USB
# reader plugged in six months later a one-command job.
#
# The supported-hardware list is deliberately NOT hardcoded here. It is read
# back out of the tables libfprint itself installs, so it stays correct across
# libfprint updates without this script being touched.

set -euo pipefail

# Generated by libfprint's own `fprint-list-udev-hwdb with all drivers
# enabled` — one stanza per driver, so it doubles as the supported-USB-device
# list (426 entries at libfprint 1.94.100).
HWDB=/usr/lib/udev/hwdb.d/60-autosuspend-libfprint-2.hwdb
# The handful of ElanTech sensors that hang off SPI instead of USB; libfprint
# ships udev rules that bind spidev to them by ACPI modalias.
SPI_RULES=/usr/lib/udev/rules.d/70-libfprint-2.rules

PAM_MODULE=/usr/lib/security/pam_fprintd.so
HYPRLOCK_CONF=/etc/hypr/hyprlock.conf

# PAM services to accept a fingerprint for. These are service names, not
# paths, because libpam resolves a service as /etc/pam.d/<svc> first and
# /usr/lib/pam.d/<svc> second: sudo still ships its file under /etc, but
# polkit now ships only the vendor copy under /usr/lib. Editing anything in
# /usr/lib is pacman's business, so for those we seed an /etc override.
#
# hyprlock is absent on purpose: it talks to fprintd over D-Bus itself
# (auth:fingerprint in hyprlock.conf) rather than through PAM, which is why
# its password field stays usable while a finger is being scanned.
PAM_SERVICES=(sudo polkit-1 greetd)
PAM_ETC_DIR=/etc/pam.d
PAM_VENDOR_DIR=/usr/lib/pam.d

PAM_BEGIN='# >>> ionix-fingerprint >>>'
PAM_END='# <<< ionix-fingerprint <<<'
# pam_fprintd only ever sends PAM_TEXT_INFO, never a prompt that can be
# dismissed, so until it gives up there is no way to fall back to typing.
# Ten seconds is long enough to present a finger and short enough that
# giving up and typing a password is not a punishment.
PAM_RULE='auth       sufficient   pam_fprintd.so timeout=10 max-tries=3'

FINGERS=(
    left-thumb left-index-finger left-middle-finger left-ring-finger left-little-finger
    right-thumb right-index-finger right-middle-finger right-ring-finger right-little-finger
)

QUIET=false

if [[ -t 1 ]]; then
    C_DIM=$'\033[2m'; C_ACC=$'\033[38;5;141m'; C_OK=$'\033[38;5;77m'
    C_WARN=$'\033[38;5;214m'; C_ERR=$'\033[38;5;203m'; C_OFF=$'\033[0m'
else
    C_DIM=; C_ACC=; C_OK=; C_WARN=; C_ERR=; C_OFF=
fi

say()  { $QUIET || printf '%s\n' "$*"; }
ok()   { $QUIET || printf '%s✓%s %s\n' "$C_OK" "$C_OFF" "$*"; }
info() { $QUIET || printf '%s·%s %s\n' "$C_DIM" "$C_OFF" "$*"; }
warn() { $QUIET || printf '%s!%s %s\n' "$C_WARN" "$C_OFF" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$C_ERR" "$C_OFF" "$*" >&2; exit 1; }

# --- hardware detection ------------------------------------------------------

# "vendor:product", lowercased, for every USB device attached right now.
present_usb_ids() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [[ -r "$d/idVendor" && -r "$d/idProduct" ]] || continue
        printf '%s:%s\n' "$(<"$d/idVendor")" "$(<"$d/idProduct")"
    done | tr 'A-Z' 'a-z' | sort -u
}

# "vendor:product<TAB>driver" for every USB sensor libfprint claims to drive.
supported_usb_ids() {
    [[ -r "$HWDB" ]] || return 0
    awk '
        /^# Supported by libfprint driver / { driver = $6; next }
        # Entries look like: usb:v06CBp00F9*
        /^usb:v/ && substr($0, 10, 1) == "p" {
            print tolower(substr($0, 6, 4)) ":" tolower(substr($0, 11, 4)) "\t" driver
        }
    ' "$HWDB" | sort -u
}

# Human-readable name for an attached USB id, straight from sysfs. Prints
# nothing when the device exposes no strings — plenty of embedded sensors
# (the Synaptics ones especially) leave manufacturer and product empty.
usb_label() {
    local want=$1 d vid pid maker product label
    for d in /sys/bus/usb/devices/*; do
        [[ -r "$d/idVendor" && -r "$d/idProduct" ]] || continue
        vid=$(<"$d/idVendor"); pid=$(<"$d/idProduct")
        [[ "${vid,,}:${pid,,}" == "$want" ]] || continue
        maker=$(cat "$d/manufacturer" 2>/dev/null || true)
        product=$(cat "$d/product" 2>/dev/null || true)
        label=$(printf '%s %s' "$maker" "$product" | sed 's/^ *//; s/ *$//')
        printf '%s' "$label"
        return 0
    done
}

matched_usb() {
    local present
    present=$(present_usb_ids)
    [[ -n "$present" ]] || return 0
    supported_usb_ids | awk -F'\t' -v present="$present" '
        BEGIN { n = split(present, a, "\n"); for (i = 1; i <= n; i++) have[a[i]] = 1 }
        have[$1] { print $1 "\t" $2 }
    '
}

supported_acpi_ids() {
    [[ -r "$SPI_RULES" ]] || return 0
    sed -n 's/.*MODALIAS}=="acpi:\([A-Za-z0-9]\{1,\}\):".*/\1/p' "$SPI_RULES" | sort -u
}

matched_acpi() {
    local hid
    while read -r hid; do
        [[ -n "$hid" ]] || continue
        # ACPI devices are named "<HID>:<instance>" under /sys/bus/acpi/devices.
        compgen -G "/sys/bus/acpi/devices/${hid}:*" >/dev/null 2>&1 || continue
        printf '%s\telanspi\n' "$hid"
    done < <(supported_acpi_ids)
}

# "<id><TAB><driver>" per supported sensor found, empty if there is none.
detect_devices() {
    matched_usb
    matched_acpi
}

# --- PAM wiring --------------------------------------------------------------

require_root() {
    [[ $EUID -eq 0 ]] || die "must run as root: sudo ionix-fingerprint $*"
}

pam_wired() { [[ -f "$1" ]] && grep -qF "$PAM_BEGIN" "$1"; }

# Whether a service is configured anywhere at all.
pam_service_exists() {
    [[ -f "$PAM_ETC_DIR/$1" || -f "$PAM_VENDOR_DIR/$1" ]]
}

pam_enable_service() {
    local svc=$1 f="$PAM_ETC_DIR/$svc" vendor="$PAM_VENDOR_DIR/$svc" tmp before after

    if [[ ! -f "$f" ]]; then
        if [[ -f "$vendor" ]]; then
            # /etc wins over /usr/lib in libpam's lookup, so copying the vendor
            # file and editing the copy is the supported way to extend a
            # service whose only file belongs to a package.
            install -Dm644 "$vendor" "$f"
            info "seeded $f from $vendor"
        else
            info "skipping $svc (no PAM file)"
            return 0
        fi
    fi
    pam_wired "$f" && { info "$svc already wired"; return 0; }

    before=$(wc -l < "$f")
    tmp=$(mktemp)
    # Goes above the existing auth stack so a matched finger short-circuits the
    # password. "sufficient" is what makes it safe: a miss, a timeout, or a
    # sensor that has gone away all just fall through to the stack below.
    awk -v begin="$PAM_BEGIN" -v rule="$PAM_RULE" -v end="$PAM_END" '
        !inserted && $1 == "auth" { print begin; print rule; print end; inserted = 1 }
        { print }
        END { if (!inserted) { print begin; print rule; print end } }
    ' "$f" > "$tmp"

    # This file gates sudo. Refuse to install anything but the exact three-line
    # addition rather than risk handing over a mangled auth stack.
    after=$(wc -l < "$tmp")
    if [[ "$after" -ne $((before + 3)) ]]; then
        rm -f "$tmp"
        die "refusing to rewrite $f: expected $((before + 3)) lines, got $after"
    fi

    cat "$tmp" > "$f"   # keeps the original inode, owner and mode
    rm -f "$tmp"
    ok "wired fingerprint auth into $f"
}

pam_disable_service() {
    local svc=$1 f="$PAM_ETC_DIR/$svc" vendor="$PAM_VENDOR_DIR/$svc" tmp
    [[ -f "$f" ]] || return 0
    pam_wired "$f" || { info "$svc was not wired"; return 0; }

    tmp=$(mktemp)
    awk -v begin="$PAM_BEGIN" -v end="$PAM_END" '
        $0 == begin { skip = 1; next }
        $0 == end   { skip = 0; next }
        !skip       { print }
    ' "$f" > "$tmp"

    [[ -s "$tmp" ]] || { rm -f "$tmp"; die "refusing to empty $f"; }

    # If dropping our block leaves an exact copy of the vendor file, delete the
    # override rather than freezing today's copy in /etc forever — otherwise
    # the service silently stops tracking its package's updates.
    if [[ -f "$vendor" ]] && cmp -s "$tmp" "$vendor"; then
        rm -f "$f" "$tmp"
        ok "removed $f ($vendor takes over again)"
        return 0
    fi

    cat "$tmp" > "$f"
    rm -f "$tmp"
    ok "removed fingerprint auth from $f"
}

# --- fingers -----------------------------------------------------------------

normalize_finger() {
    local f=${1,,}
    f=${f//_/-}
    # Accept the shorthand people actually type ("right-index").
    case "$f" in
        *-thumb|*-finger) ;;
        *) f="${f}-finger" ;;
    esac
    local valid
    for valid in "${FINGERS[@]}"; do
        [[ "$f" == "$valid" ]] && { printf '%s' "$f"; return 0; }
    done
    die "unknown finger '$1'; try one of: ${FINGERS[*]}"
}

# fprintd stores prints per user; running these under sudo would enroll root.
refuse_root_for_user_action() {
    [[ $EUID -eq 0 ]] || return 0
    die "run this as yourself, not with sudo — fprintd stores prints per user"
}

# --- commands ----------------------------------------------------------------

cmd_detect() {
    local found
    found=$(detect_devices)
    if [[ -z "$found" ]]; then
        say "No libfprint-supported fingerprint reader found."
        return 1
    fi
    local id driver label
    while IFS=$'\t' read -r id driver; do
        if [[ "$id" == *:* ]]; then
            label=$(usb_label "$id")
            ok "${label:-Fingerprint reader} ${C_DIM}[USB $id, libfprint driver: $driver]${C_OFF}"
        else
            ok "Fingerprint reader ${C_DIM}[SPI $id, libfprint driver: $driver]${C_OFF}"
        fi
    done <<< "$found"
    return 0
}

cmd_status() {
    printf '%sReader%s\n' "$C_ACC" "$C_OFF"
    local have_device=true
    cmd_detect || have_device=false

    printf '\n%sDaemon%s\n' "$C_ACC" "$C_OFF"
    if [[ -e "$PAM_MODULE" ]]; then
        # fprintd.service is Type=dbus with no [Install] section, so it is
        # activated on demand and can never be "enabled" — nothing to check.
        ok "fprintd installed (D-Bus activated, no service to enable)"
    else
        warn "fprintd is not installed"
    fi

    printf '\n%sPAM%s\n' "$C_ACC" "$C_OFF"
    local svc
    for svc in "${PAM_SERVICES[@]}"; do
        if ! pam_service_exists "$svc"; then
            info "$svc — not configured on this system"
        elif pam_wired "$PAM_ETC_DIR/$svc"; then
            ok "$svc — fingerprint accepted"
        else
            info "$svc — password only"
        fi
    done

    printf '\n%sLock screen%s\n' "$C_ACC" "$C_OFF"
    if [[ -f "$HYPRLOCK_CONF" ]] && grep -q 'fingerprint' "$HYPRLOCK_CONF"; then
        ok "$HYPRLOCK_CONF — fingerprint accepted (direct, not via PAM)"
    else
        info "$HYPRLOCK_CONF — password only"
    fi

    printf '\n%sEnrolled%s\n' "$C_ACC" "$C_OFF"
    if ! $have_device; then
        info "nothing to enroll against"
    elif ! command -v fprintd-list >/dev/null 2>&1; then
        info "fprintd-list unavailable"
    else
        local listing
        # Needs a live D-Bus, so this is the one check that cannot answer
        # from inside the installer chroot.
        if listing=$(fprintd-list "$(id -un)" 2>&1) && grep -q '#[0-9]' <<< "$listing"; then
            grep -o '#[0-9]*: *[a-z-]*' <<< "$listing" | sed 's/.*: *//' | while read -r finger; do
                ok "$finger"
            done
        else
            info "no fingerprints enrolled — run: ionix-fingerprint enroll"
        fi
    fi
}

cmd_enable() {
    require_root enable
    [[ -e "$PAM_MODULE" ]] || die "pam_fprintd.so is missing; install the fprintd package first"
    if ! detect_devices | grep -q .; then
        warn "no supported reader found; wiring PAM up anyway because you asked"
    fi
    local svc
    for svc in "${PAM_SERVICES[@]}"; do
        pam_enable_service "$svc"
    done
    say ""
    say "Now enroll a finger (as your own user, no sudo):"
    say "    ionix-fingerprint enroll"
}

cmd_disable() {
    require_root disable
    local svc
    for svc in "${PAM_SERVICES[@]}"; do
        pam_disable_service "$svc"
    done
    info "hyprlock reads $HYPRLOCK_CONF directly; edit auth:fingerprint:enabled there to turn it off too"
}

cmd_enroll() {
    refuse_root_for_user_action
    command -v fprintd-enroll >/dev/null 2>&1 || die "fprintd is not installed"
    detect_devices | grep -q . || die "no supported fingerprint reader found (see: ionix-fingerprint detect)"

    local finger
    finger=$(normalize_finger "${1:-right-index-finger}")
    say "Enrolling ${C_ACC}${finger}${C_OFF}. Lift and rest your finger on the reader repeatedly."
    fprintd-enroll -f "$finger"
    ok "enrolled $finger"

    local svc wired=false
    for svc in "${PAM_SERVICES[@]}"; do
        pam_wired "$PAM_ETC_DIR/$svc" && wired=true
    done
    $wired || warn "PAM is not wired up yet — run: sudo ionix-fingerprint enable"
}

cmd_list() {
    refuse_root_for_user_action
    command -v fprintd-list >/dev/null 2>&1 || die "fprintd is not installed"
    fprintd-list "$(id -un)"
}

cmd_forget() {
    refuse_root_for_user_action
    command -v fprintd-delete >/dev/null 2>&1 || die "fprintd is not installed"
    fprintd-delete "$(id -un)"
    ok "deleted all enrolled fingerprints for $(id -un)"
}

usage() {
    cat <<'USAGE'
ionix-fingerprint — fingerprint reader support for Ionix

Usage: ionix-fingerprint <command> [args]

  status              Show reader, daemon, PAM, lock screen and enrolled fingers
  detect              Exit 0 if a libfprint-supported reader is attached
  enable              Accept fingerprints for sudo and polkit prompts (root)
  disable             Undo that (root)
  enroll [finger]     Enroll a finger, default right-index-finger
  list                List fingers enrolled for the current user
  forget              Delete every fingerprint enrolled for the current user

Options:
  -q, --quiet         Suppress informational output (for scripting)

Fingers: left/right + thumb, index, middle, ring, little
         ("right-index" and "right-index-finger" both work)

The lock screen is configured separately, in /etc/hypr/hyprlock.conf, because
hyprlock talks to fprintd itself rather than going through PAM.
USAGE
}

main() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quiet) QUIET=true ;;
            -h|--help)  usage; return 0 ;;
            *)          args+=("$1") ;;
        esac
        shift
    done
    set -- "${args[@]+"${args[@]}"}"

    case "${1:-status}" in
        status)  cmd_status ;;
        detect)  cmd_detect ;;
        enable)  cmd_enable ;;
        disable) cmd_disable ;;
        enroll)  cmd_enroll "${2:-}" ;;
        list)    cmd_list ;;
        forget)  cmd_forget ;;
        *)       usage >&2; return 2 ;;
    esac
}

main "$@"
