#!/usr/bin/env bash
# Mount the EFI partition at <target>/boot/efi from the HOST side.
# Runs outside the chroot (dontChroot: true) where we have full device access.
# Calamares passes @@ROOT@@ as $1.

set -euo pipefail

TARGET="$1"
EFI_DIR="${TARGET}/boot/efi"

mkdir -p "$EFI_DIR"

# Already mounted — nothing to do
if mountpoint -q "$EFI_DIR"; then
    echo "EFI partition already mounted at $EFI_DIR"
    exit 0
fi

# Try mounting via the target's fstab (generated by the fstab module)
if [[ -f "${TARGET}/etc/fstab" ]]; then
    EFI_SRC=$(awk '$2 == "/boot/efi" {print $1}' "${TARGET}/etc/fstab")
    if [[ -n "$EFI_SRC" ]]; then
        echo "Mounting $EFI_SRC at $EFI_DIR (from fstab)"
        if mount "$EFI_SRC" "$EFI_DIR" -o umask=0077; then
            exit 0
        fi
        echo "WARNING: fstab-based mount failed, trying fallback"
    fi
fi

# Fallback: find the FAT32 EFI system partition via blkid
EFI_DEV=$(blkid -t PARTLABEL=EFI -o device 2>/dev/null | head -1)
if [[ -z "$EFI_DEV" ]]; then
    EFI_DEV=$(blkid -t TYPE=vfat -o device 2>/dev/null | head -1)
fi

if [[ -n "$EFI_DEV" ]]; then
    echo "Mounting $EFI_DEV at $EFI_DIR (fallback)"
    mount -t vfat "$EFI_DEV" "$EFI_DIR" -o umask=0077
else
    echo "ERROR: No EFI partition found"
    exit 1
fi
