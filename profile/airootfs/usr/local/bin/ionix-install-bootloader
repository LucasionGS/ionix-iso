#!/usr/bin/env bash
# Ionix Bootloader Installer
# Runs on the HOST (dontChroot: true).
# Calamares passes @@ROOT@@ as $1.

set -euo pipefail

HLOG="/tmp/ionix-bootloader.log"
mkdir -p /tmp
> "$HLOG"   # truncate / create before anything else

{
    echo "=== ionix-install-bootloader ===" ; date
    echo "ARGS: $*"

    # ── Find the installed target root ────────────────────────────────────────
    TARGET="${1:-}"

    if [[ -z "$TARGET" || ! -d "$TARGET/etc" ]]; then
        echo "@@ROOT@@ missing or invalid ('$TARGET'), scanning mounts..."
        while IFS= read -r mnt; do
            [[ "$mnt" == "/" ]] && continue
            if [[ -f "$mnt/etc/os-release" ]]; then
                TARGET="$mnt"
                break
            fi
        done < <(findmnt -n -l -o TARGET | sort)
    fi

    if [[ -z "$TARGET" || ! -d "$TARGET/etc" ]]; then
        echo "ERROR: Cannot determine target root. Mounts:"
        findmnt -n -l || true
        exit 1
    fi

    echo "TARGET: $TARGET"
    echo "Mounts under TARGET:"
    findmnt -n -l | grep "^${TARGET}" || echo "  (none)"

    EFI_DIR="${TARGET}/boot/efi"
    BOOT_DIR="${TARGET}/boot"

    udevadm settle 2>/dev/null || true

    # ── Ensure EFI partition is mounted ──────────────────────────────────────
    mkdir -p "${EFI_DIR}"

    if mountpoint -q "${EFI_DIR}"; then
        echo "EFI already mounted: ${EFI_DIR}"
    else
        echo "EFI not mounted — mounting..."

        # Method 1: fstab
        if [[ -f "${TARGET}/etc/fstab" ]]; then
            EFI_SRC=$(awk '$2 == "/boot/efi" { print $1 }' "${TARGET}/etc/fstab")
            if [[ -n "$EFI_SRC" ]]; then
                echo "  fstab: $EFI_SRC"
                mount "$EFI_SRC" "${EFI_DIR}" 2>&1 && echo "  OK" || true
            fi
        fi

        # Method 2: EFI System Partition type GUID
        if ! mountpoint -q "${EFI_DIR}"; then
            EFI_DEV=$(blkid -t PARTTYPE="C12A7328-F81F-11D2-BA4B-00A0C93EC93B" \
                -o device 2>/dev/null | head -1 || true)
            if [[ -n "$EFI_DEV" ]]; then
                echo "  ESP GUID: $EFI_DEV"
                mount -t vfat "$EFI_DEV" "${EFI_DIR}" 2>&1 && echo "  OK" || true
            fi
        fi

        # Method 3: partition label
        if ! mountpoint -q "${EFI_DIR}"; then
            EFI_DEV=$(blkid -t PARTLABEL=EFI -o device 2>/dev/null | head -1 || true)
            if [[ -n "$EFI_DEV" ]]; then
                echo "  PARTLABEL=EFI: $EFI_DEV"
                mount -t vfat "$EFI_DEV" "${EFI_DIR}" 2>&1 && echo "  OK" || true
            fi
        fi

        # Method 4: first FAT32 partition
        if ! mountpoint -q "${EFI_DIR}"; then
            EFI_DEV=$(blkid -t TYPE=vfat -o device 2>/dev/null | head -1 || true)
            if [[ -n "$EFI_DEV" ]]; then
                echo "  TYPE=vfat: $EFI_DEV"
                mount -t vfat "$EFI_DEV" "${EFI_DIR}" 2>&1 && echo "  OK" || true
            fi
        fi
    fi

    if ! mountpoint -q "${EFI_DIR}"; then
        echo "ERROR: Could not mount EFI. blkid:"
        blkid || true
        exit 1
    fi

    echo "EFI contents before grub-install:"
    ls -la "${EFI_DIR}/" || true

    udevadm settle 2>/dev/null || true

    # ── Install GRUB ──────────────────────────────────────────────────────────
    echo "Running grub-install..."
    /usr/bin/grub-install \
        --target=x86_64-efi \
        --efi-directory="${EFI_DIR}" \
        --boot-directory="${BOOT_DIR}" \
        --bootloader-id=Ionix \
        --no-nvram \
        --verbose

    echo "EFI contents after grub-install:"
    find "${EFI_DIR}" -type f || true

    # ── Fallback EFI binary ───────────────────────────────────────────────────
    mkdir -p "${EFI_DIR}/EFI/BOOT"
    if cp "${EFI_DIR}/EFI/Ionix/grubx64.efi" "${EFI_DIR}/EFI/BOOT/BOOTX64.EFI"; then
        echo "Wrote EFI/BOOT/BOOTX64.EFI"
    else
        echo "WARNING: Could not copy fallback EFI binary"
        find "${EFI_DIR}" -name "*.efi" 2>/dev/null || true
    fi

    # ── Generate GRUB config ──────────────────────────────────────────────────
    echo "Running grub-mkconfig..."
    arch-chroot "${TARGET}" grub-mkconfig -o /boot/grub/grub.cfg 2>&1 || \
        echo "WARNING: grub-mkconfig returned non-zero"

    # ── Copy log to installed disk ────────────────────────────────────────────
    mkdir -p "${TARGET}/var/log" 2>/dev/null || true
    cp "$HLOG" "${TARGET}/var/log/ionix-bootloader.log" 2>/dev/null || true

    echo "=== ionix-install-bootloader complete ==="

} 2>&1 | tee -a "$HLOG"
