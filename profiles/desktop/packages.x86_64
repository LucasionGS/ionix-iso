mesa
vulkan-radeon
vulkan-intel
vulkan-icd-loader
lib32-mesa
lib32-vulkan-radeon
lib32-vulkan-intel
lib32-vulkan-icd-loader
mesa-utils
vulkan-tools
libva
libva-mesa-driver
lib32-libva
lib32-libva-mesa-driver

# --- GPU Drivers (NVIDIA) ---
nvidia-open
nvidia-utils
lib32-nvidia-utils
egl-wayland
libva-nvidia-driver

# --- Performance ---
# Not gaming-specific: ionix-post-install enables its service on every install.
ananicy-cpp

