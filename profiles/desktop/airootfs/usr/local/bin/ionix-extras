#!/usr/bin/env bash
# ionix-extras — install Ionix's optional software bundles.
#
#   ionix-extras list
#   sudo ionix-extras install <bundle>...     install these bundles
#   sudo ionix-extras install                 install whatever is still pending
#
# None of the bundles is on the installation medium. The installer's Software
# page records the choice and Calamares runs this inside the new system (see
# /etc/calamares/modules/shellprocess.conf) with --during-install and --user.
#
# Repo packages come from pacman. AUR packages are built with yay as a regular
# user, because makepkg refuses to run as root — so they need --user, or sudo's
# SUDO_USER. Whatever cannot be installed (offline, a failed build) is recorded
# in $PENDING, ionix-first-login reminds the user, and a plain
# `sudo ionix-extras install` later picks it up.
#
# The bundle ids must match branding/ionix/ionix-software.qml.

set -uo pipefail

PENDING=/var/lib/ionix/extras-pending
LOG=/var/log/ionix-extras.log
SUDOERS_DROPIN=/etc/sudoers.d/99-ionix-extras
PACMAN_CONF=/etc/pacman.conf

BUNDLES=(gaming obs tabby)

declare -A TITLE=(
    [gaming]="Gaming"
    [obs]="OBS Studio"
    [tabby]="Tabby terminal"
)
# lib32-* need [multilib]; enable_multilib below makes sure it is on.
declare -A REPO_PKGS=(
    [gaming]="steam gamemode lib32-gamemode mangohud lib32-mangohud gamescope lutris antimicrox lib32-libpulse wine-staging winetricks wine-mono wine-gecko"
    [obs]="obs-studio"
    [tabby]=""
)
declare -A AUR_PKGS=(
    [gaming]="protonup-qt"
    [obs]=""
    [tabby]="tabby-bin"
)
# Packages whose presence means the bundle is installed: one from pacman and,
# where the bundle has one, its AUR package, so a failed AUR build keeps the
# bundle pending even though the repo half went in.
declare -A MARKER_PKGS=(
    [gaming]="steam protonup-qt"
    [obs]="obs-studio"
    [tabby]="tabby-bin"
)

msg()  { printf '\033[1;35m[ionix-extras]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[ionix-extras]\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<EOF
Usage: ionix-extras list
       sudo ionix-extras install [--user NAME] [bundle...]

Bundles: ${BUNDLES[*]}
With no bundle names, install installs whatever an earlier run left pending.
EOF
}

is_bundle() {
    local b
    for b in "${BUNDLES[@]}"; do [[ "$b" == "$1" ]] && return 0; done
    return 1
}

is_installed() {
    local -a pkgs
    read -ra pkgs <<< "${MARKER_PKGS[$1]}"
    pacman -Q "${pkgs[@]}" >/dev/null 2>&1
}

read_pending() { [[ -s "$PENDING" ]] && tr ' \n' '\n\n' < "$PENDING" | grep -v '^$' | sort -u; }

write_pending() {
    mkdir -p "$(dirname "$PENDING")"
    if [[ $# -eq 0 ]]; then
        rm -f "$PENDING"
    else
        printf '%s\n' "$@" | sort -u > "$PENDING"
    fi
}

online() { curl -fsI --max-time 15 https://archlinux.org >/dev/null 2>&1; }

# Idempotent: uncomment the stock [multilib] stanza, or append one.
enable_multilib() {
    if grep -q '^\[multilib\]' "$PACMAN_CONF"; then
        return 0
    fi
    if grep -q '^#\[multilib\]' "$PACMAN_CONF"; then
        sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' "$PACMAN_CONF"
    else
        printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> "$PACMAN_CONF"
    fi
}

cmd_list() {
    local b state
    for b in "${BUNDLES[@]}"; do
        if is_installed "$b"; then
            state="installed"
        elif read_pending | grep -qx "$b"; then
            state="pending"
        else
            state="-"
        fi
        printf '  %-8s %-16s %s\n' "$b" "${TITLE[$b]}" "$state"
    done
}

cmd_install() {
    local user="${SUDO_USER:-}" during_install=false
    local -a wanted=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)           user="$2"; shift 2 ;;
            --during-install) during_install=true; shift ;;
            none|"")          shift ;;      # the installer's "nothing selected"
            *,*)              IFS=, read -ra more <<< "$1"; wanted+=("${more[@]}"); shift ;;
            *)                wanted+=("$1"); shift ;;
        esac
    done

    if [[ $EUID -ne 0 ]]; then
        warn "Run this with sudo."
        return 1
    fi

    if [[ ${#wanted[@]} -eq 0 ]]; then
        mapfile -t wanted < <(read_pending)
        if [[ ${#wanted[@]} -eq 0 ]]; then
            $during_install || msg "Nothing to install. Bundles: ${BUNDLES[*]}"
            return 0
        fi
    fi

    local b
    local -a todo=()
    for b in "${wanted[@]}"; do
        if ! is_bundle "$b"; then
            warn "Unknown bundle '$b' (known: ${BUNDLES[*]})"
            continue
        fi
        is_installed "$b" && { msg "${TITLE[$b]} is already installed."; continue; }
        todo+=("$b")
    done
    [[ ${#todo[@]} -eq 0 ]] && { write_pending; return 0; }

    msg "Installing: ${todo[*]}"

    if ! online; then
        warn "No internet connection; leaving ${todo[*]} for later."
        write_pending $(read_pending) "${todo[@]}"
        $during_install && return 0
        return 1
    fi

    enable_multilib

    local -a repo=() aur=()
    for b in "${todo[@]}"; do
        read -ra pk <<< "${REPO_PKGS[$b]}"; repo+=("${pk[@]}")
        read -ra pk <<< "${AUR_PKGS[$b]}";  aur+=("${pk[@]}")
    done

    # -Syu, never a bare -Sy: the system on disk is as old as the ISO, and new
    # packages built against today's libraries on top of it is a partial upgrade.
    local repo_ok=true
    if ! pacman -Syu --needed --noconfirm "${repo[@]}"; then
        repo_ok=false
        warn "pacman failed; see $LOG"
    fi

    local aur_ok=true
    if $repo_ok && [[ ${#aur[@]} -gt 0 ]]; then
        if [[ -z "$user" ]] || ! id "$user" >/dev/null 2>&1; then
            warn "AUR packages (${aur[*]}) need a regular user to build as: pass --user NAME or run through sudo."
            aur_ok=false
        else
            build_aur "$user" "${aur[@]}" || aur_ok=false
        fi
    fi

    # Whatever did not make it stays pending; a later run retries only that.
    local -a still=()
    for b in "${todo[@]}"; do
        is_installed "$b" || still+=("$b")
    done
    local -a keep=()
    while read -r b; do
        # is_bundle: a bundle this version no longer offers (GNOME, dropped in
        # 2026.09) would otherwise stay "pending" forever.
        [[ -n "$b" ]] && is_bundle "$b" && ! printf '%s\n' "${todo[@]}" | grep -qx "$b" && keep+=("$b")
    done < <(read_pending)
    write_pending "${keep[@]}" "${still[@]}"

    if [[ ${#still[@]} -eq 0 ]]; then
        msg "Done: ${todo[*]}"
        return 0
    fi
    warn "Not installed: ${still[*]} — run 'sudo ionix-extras install' to retry."
    $during_install && return 0
    return 1
}

# makepkg will not run as root, so yay runs as the user with a temporary
# NOPASSWD rule for pacman only, removed again however this exits.
build_aur() {
    local user="$1"; shift
    local home
    home="$(getent passwd "$user" | cut -d: -f6)"

    # EXIT as well as the explicit rm below: Calamares kills a command that runs
    # past its timeout, and a leftover rule would be passwordless root forever.
    trap 'rm -f "$SUDOERS_DROPIN"' EXIT
    printf '%s ALL=(ALL) NOPASSWD: /usr/bin/pacman\n' "$user" > "$SUDOERS_DROPIN"
    chmod 440 "$SUDOERS_DROPIN"

    # --nocheck: a package's own test suite is not ours to gate an install on.
    sudo -u "$user" -H env HOME="$home" \
        yay -S --needed --noconfirm \
            --answerclean None --answerdiff None --answeredit None \
            --removemake --mflags --nocheck "$@"
    local rc=$?
    rm -f "$SUDOERS_DROPIN"
    rm -rf "$home/.cache/yay"
    [[ $rc -eq 0 ]] || warn "yay failed for: $*"
    return $rc
}

main() {
    case "${1:-}" in
        list)            cmd_list ;;
        install)         shift
                         mkdir -p "$(dirname "$LOG")"
                         cmd_install "$@" 2>&1 | tee -a "$LOG"
                         return "${PIPESTATUS[0]}" ;;
        -h|--help|help)  usage ;;
        *)               usage; return 1 ;;
    esac
}

main "$@"
