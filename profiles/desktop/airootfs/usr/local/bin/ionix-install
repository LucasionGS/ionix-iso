#!/usr/bin/env bash
# Launch the Ionix installer (Calamares) with elevated privileges.
# sudo strips the environment, so we explicitly forward the Wayland session
# variables — otherwise Qt falls back to XCB, finds no X display, and aborts.
sudo env \
    QT_QPA_PLATFORM=wayland \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    calamares -d 2>&1 | tee /tmp/calamares-debug.log
