#!/usr/bin/env bash
# Installation of the theme
# Available variables:
# THEME_DIR - Full directory path to the theme to be installed
# THEME_NAME - The name of the theme being installed

# Functions can be overridden to customize installation/uninstallation for specific sections, and one for additional custom requirements.
# Copy this file into the theme directory and modify as needed. Functions present in the file will override the default installation behavior for the corresponding section.

# Overridable so the tree can be exercised from a git checkout before it is
# installed; nothing on a running system sets it.
IONIX_BIN="${IONIX_BIN:-/usr/local/share/ionix/bin}"
IONIX_ADAPTIVE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ionix/adaptive-colors"

# ── Adaptive colours ────────────────────────────────────────
#
# A theme opts in by setting `export USE_ADAPTIVE_COLORS=true` in its own
# `install` file, which ionixtheme sources after this one. Its colours are then
# derived from the current wallpaper by ionix-adaptive-colors and land under
# $IONIX_ADAPTIVE_DIR/<section>/<file>, mirroring the theme's own layout.
#
# Reset here, not just left unset. A theme switch uninstalls the outgoing theme
# first, which means its `install` file has already been sourced into this same
# process by the time the incoming one loads — so without this line, switching
# from an adaptive theme to a plain one would leave the flag set and install the
# old theme's generated files under the new theme's name. ionixtheme's
# clear_ionix_functions unsets functions between loads but not variables, and
# this file is sourced before the theme's own, which is what makes it the place
# to state the default.
USE_ADAPTIVE_COLORS=false
#
# Which file a section installs. The generated one when the theme opted in and
# the generator actually produced something; the theme's own otherwise. That
# fallback is what makes "no wallpaper", "no matugen", "matugen failed" and "the
# live ISO" all degrade to a working theme instead of a broken one, so an
# adaptive theme must ship a static file for every template it has.
ionix_theme_file() {
  local section="$1" file="$2"
  local generated="$IONIX_ADAPTIVE_DIR/$section/$file"

  if [[ "${USE_ADAPTIVE_COLORS:-false}" == true && -s "$generated" ]]; then
    printf '%s\n' "$generated"
  else
    printf '%s\n' "$THEME_DIR/$section/$file"
  fi
}

# Called by ionixtheme after the installers load and before they run, so
# whatever it generates exists by the time the symlinks are made. A theme may
# override it to prepare something else entirely.
ionix_prepare() {
  [[ "${USE_ADAPTIVE_COLORS:-false}" == true ]] || return 0
  [[ -x "$IONIX_BIN/ionix-adaptive-colors" ]] || return 0

  # --force because the theme is changing, which the stamp cannot see; and
  # FROM_STYLER because run_installers is about to make every symlink itself.
  IONIX_ADAPTIVE_FROM_STYLER=1 "$IONIX_BIN/ionix-adaptive-colors" --force || true
}

# ── Availability ────────────────────────────────────────────
#
# The same themes serve the desktop and the server, where most of the apps
# below are not installed. A section whose ionix_available_<section> fails is
# not installed (ionixtheme and ionix-adaptive-colors both ask), so a server
# gets the terminal sections without a ~/.config full of desktop configs. A
# section without one is always installed. Uninstallers always run: they only
# remove what an earlier install left behind.
ionix_available_waybar()     { command -v waybar &>/dev/null; }
ionix_available_quickshell() { command -v qs &>/dev/null; }
ionix_available_ioexplorer() { command -v ioexplorer &>/dev/null; }
ionix_available_hyprland()   { command -v Hyprland &>/dev/null; }
ionix_available_wallpaper()  { [[ -x "$IONIX_BIN/ionix-wallpaper" ]]; }
ionix_available_kitty()      { command -v kitty &>/dev/null; }
ionix_available_ionterm()    { command -v ionterm &>/dev/null; }
ionix_available_fish()       { command -v fish &>/dev/null; }
ionix_available_prompt()     { command -v oh-my-posh &>/dev/null; }
ionix_available_btop()       { command -v btop &>/dev/null; }
# kmscon is only set up on the server; the desktop's plain VTs take their
# palette from the fish section instead.
ionix_available_tty()        { [[ -f "${IONIX_KMSCON_CONF:-/etc/kmscon/kmscon.conf}" ]]; }

# Waybar
ionix_install_waybar() {
  local dest="$HOME/.config/waybar"
  mkdir -p "$dest"
  ln -sf "$(ionix_theme_file waybar config)" "$dest/config"
  ln -sf "$(ionix_theme_file waybar style.css)" "$dest/style.css"

  # Reload waybar if it's running to apply the new configuration
  if pgrep -x waybar &>/dev/null; then
    killall -SIGUSR2 waybar 2>/dev/null && msg "waybar: reloaded" || true
  fi
}

ionix_uninstall_waybar() {
  rm -f "$HOME/.config/waybar/config"
  rm -f "$HOME/.config/waybar/style.css"
}

# Quickshell (ionix-quickshell)
#
# The shell reads three layers: its shipped defaults, then theme.json (ours), then
# the user's own config.json. Dropping a symlink in the middle slot restyles the
# shell without touching anything the user wrote.
#
# Only JSON goes here — a shell.qml in this directory would shadow /etc/xdg and
# take over the whole shell instead of overriding it.
ionix_install_quickshell() {
  local dest="$HOME/.config/quickshell/ionix"
  mkdir -p "$dest"
  ln -sf "$(ionix_theme_file quickshell theme.json)" "$dest/theme.json"

  ionix_reload_quickshell
}

ionix_uninstall_quickshell() {
  rm -f "$HOME/.config/quickshell/ionix/theme.json"
  ionix_reload_quickshell
}

# ln -sf replaces the symlink rather than writing through it, so the inode the
# shell was watching disappears. Nudge it over IPC instead of trusting the watch.
ionix_reload_quickshell() {
  command -v qs &>/dev/null || return 0
  qs -c ionix ipc call theme reload &>/dev/null && msg "quickshell: reloaded" || true
}

# IoExplorer (file manager + start menu + spotlight)
#
# theme.css is the path IoExplorer already falls back to when config.toml sets no
# custom_css, so a symlink here themes it without editing the user's config.
#
# No reload nudge: LiveConfig watches the *directory* with WATCH_MOVES precisely
# because saves replace the file rather than rewriting it, so swapping the symlink
# is an event it already handles.
ionix_install_ioexplorer() {
  local dest="$HOME/.config/ioexplorer"
  local css="$dest/theme.css"
  local configured
  mkdir -p "$dest"

  # A theme.css that is a real file is the user's own — Settings -> Theme writes
  # by renaming over the path, which replaces our symlink with their palette.
  # Same reasoning as the kitty backup below, but it is never auto-restored:
  # putting one theme's colours back while a different theme is active is worse
  # than leaving the file for them to pick up.
  if [[ -f "$css" && ! -L "$css" ]]; then
    local backup="$css.bak"
    local n=1
    # Never overwrite an older backup — number instead. Losing a palette someone
    # sat and tuned is not a reasonable cost for switching theme.
    while [[ -e "$backup" ]]; do
      backup="$css.bak.$((n++))"
    done

    msg "ioexplorer: existing theme.css found, backing up to $(basename "$backup")"
    mv "$css" "$backup"
  fi

  ln -sf "$(ionix_theme_file ioexplorer theme.css)" "$css"

  # custom_css may point somewhere else entirely, in which case the file we just
  # linked is simply never read.
  configured="$(ionix_ioexplorer_custom_css)"
  if [[ -n "$configured" && "$configured" != "$css" ]]; then
    err "ioexplorer: config.toml sets custom_css = $configured"
    err "ioexplorer: the theme installed to $css and will NOT be used until that is cleared"
  fi
}

ionix_uninstall_ioexplorer() {
  local css="$HOME/.config/ioexplorer/theme.css"

  # Only ever remove our own symlink; a real file here is the user's palette.
  if [[ -L "$css" ]]; then
    rm -f "$css"
  elif [[ -e "$css" ]]; then
    msg "ioexplorer: theme.css is not our symlink, keeping it"
  fi
}

# The custom_css path from config.toml, empty when unset. Last assignment wins,
# matching how a TOML parser treats a duplicated key at the top level.
ionix_ioexplorer_custom_css() {
  local config="$HOME/.config/ioexplorer/config.toml"
  [[ -f "$config" ]] || return 0
  sed -n 's/^[[:space:]]*custom_css[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$config" | tail -n1
}

# Hyprland
ionix_install_hyprland() {
  local dest="$HOME/.config/hypr"
  mkdir -p "$dest"
  # ~/.config/hypr/theme.conf is sourced by the main hyprland.conf
  ln -sf "$THEME_DIR/hyprland/theme.conf" "$dest/theme.conf" # Deprecated, never adaptive
  ln -sf "$(ionix_theme_file hyprland theme.lua)" "$dest/theme.lua"

  # &> not 2>: a successful `hyprctl reload` prints "ok" on stdout, which was
  # tolerable once per theme switch and is noise now that a wallpaper change
  # re-runs this installer.
  hyprctl reload &>/dev/null && msg "hyprland: reloaded" || true
}

ionix_uninstall_hyprland() {
  rm -f "$HOME/.config/hypr/theme.conf" # Deprecated
  rm -f "$HOME/.config/hypr/theme.lua"
  # &> not 2>: a successful `hyprctl reload` prints "ok" on stdout, which was
  # tolerable once per theme switch and is noise now that a wallpaper change
  # re-runs this installer.
  hyprctl reload &>/dev/null && msg "hyprland: reloaded" || true
}

# Wallpapers
ionix_install_wallpaper() {
  "$IONIX_BIN/ionix-wallpaper" "$THEME_DIR"/wallpaper/*
  "$IONIX_BIN/ionix-cycle-wallpaper"
}

ionix_uninstall_wallpaper() {
  # No specific uninstallation steps needed for wallpapers
  :
}

# Kitty config
ionix_install_kitty() {
  local dest="$HOME/.config/kitty"
  mkdir -p "$dest"

  # Backup existing kitty.conf if it exists. kitty can't merge configurations...
  #
  # `! -L` matters: -f follows symlinks, so without it our own symlink counts as
  # "an existing configuration" and gets renamed to .bak. That is survivable on a
  # theme switch, which uninstalls first, but ionix-adaptive-colors re-runs this
  # installer on every wallpaper change with no uninstall in between — which
  # would eat a real user backup within a few keypresses.
  if [[ -f "$dest/kitty.conf" && ! -L "$dest/kitty.conf" ]]; then
    msg "kitty: existing configuration found, backing up to kitty.conf.bak"
    mv "$dest/kitty.conf" "$dest/kitty.conf.bak"
  fi

  ln -sf "$(ionix_theme_file kitty kitty.conf)" "$dest/kitty.conf"

  ionix_reload_kitty
}

# kitty re-reads its config on SIGUSR1 — the same signal `kitten @ load-config`
# sends — so terminals that are already open follow a theme or wallpaper change
# instead of waiting to be restarted.
ionix_reload_kitty() {
  pgrep -x kitty &>/dev/null || return 0
  pkill -USR1 -x kitty 2>/dev/null && msg "kitty: reloaded"
  return 0
}

ionix_uninstall_kitty() {
  if [[ -f "$HOME/.config/kitty/kitty.conf.bak" ]]; then
    rm -f "$HOME/.config/kitty/kitty.conf"
    msg "kitty: restoring backup configuration"
    mv "$HOME/.config/kitty/kitty.conf.bak" "$HOME/.config/kitty/kitty.conf"
    ionix_reload_kitty
  fi
  # If no backup exists, keep it to avoid deleting user configuration
}

# ionterm (the default terminal)
#
# Only the colours are ours: theme.toml sits next to the user's ionterm.toml,
# which ionterm reads separately, so unlike kitty nothing they wrote is replaced.
ionix_install_ionterm() {
  local dest="$HOME/.config/ionterm"
  local theme="$dest/theme.toml"
  mkdir -p "$dest"

  # A real file here is the user's own palette; keep it, numbered, rather than
  # overwrite it (same reasoning as ioexplorer's theme.css).
  if [[ -f "$theme" && ! -L "$theme" ]]; then
    local backup="$theme.bak"
    local n=1
    while [[ -e "$backup" ]]; do
      backup="$theme.bak.$((n++))"
    done

    msg "ionterm: existing theme.toml found, backing up to $(basename "$backup")"
    mv "$theme" "$backup"
  fi

  # No reload nudge: ionterm watches ~/.config/ionterm and picks up the new
  # symlink within about 250 ms.
  ln -sf "$(ionix_theme_file ionterm theme.toml)" "$theme"
}

ionix_uninstall_ionterm() {
  local theme="$HOME/.config/ionterm/theme.toml"
  if [[ -L "$theme" ]]; then
    rm -f "$theme"
  elif [[ -e "$theme" ]]; then
    msg "ionterm: theme.toml is not our symlink, keeping it"
  fi
}

# Thunderbird
IONIX_TB_MARK="ionix-styler"

# <user sheet>:<link we own>. The link is what the theme file is installed as,
# and the theme's own file shares the user sheet's name.
IONIX_TB_SHEETS=(
  "userChrome.css:ionix-theme.css"
)

# The profile directories of every native Thunderbird install, one per line.
# ~/.config/thunderbird is where Thunderbird 14x+ keeps new profiles (XDG);
# ~/.thunderbird is every install older than that. Flatpak is left out on
# purpose: its sandbox cannot see /usr/local/share, so the symlink would dangle.
ionix_thunderbird_profiles() {
  local root
  for root in "${XDG_CONFIG_HOME:-$HOME/.config}/thunderbird" "$HOME/.thunderbird"; do
    [[ -f "$root/profiles.ini" ]] || continue
    # Path= only inside [ProfileN] sections — [Install*] sections carry a
    # Default= that names the same directories again.
    awk -F= -v root="$root" '
      function flush() { if (path != "") print (rel == "0" ? path : root "/" path); path = ""; rel = 1 }
      { sub(/\r$/, "") }
      /^\[/       { flush(); in_profile = ($0 ~ /^\[Profile[0-9]+\]/); next }
      !in_profile { next }
      $1 == "IsRelative" { rel = $2 }
      $1 == "Path"       { path = substr($0, 6) }
      END { flush() }
    ' "$root/profiles.ini"
  done | while IFS= read -r dir; do
    [[ -d "$dir" ]] && printf '%s\n' "$dir"
  done
}

ionix_install_thunderbird() {
  local profile chrome userjs pair sheet link import found=0

  while IFS= read -r profile; do
    found=1
    chrome="$profile/chrome"
    userjs="$profile/user.js"
    mkdir -p "$chrome"

    for pair in "${IONIX_TB_SHEETS[@]}"; do
      sheet="$chrome/${pair%%:*}"
      link="${pair#*:}"
      import="@import url(\"$link\"); /* $IONIX_TB_MARK: managed by ionixtheme */"

      ln -sf "$(ionix_theme_file thunderbird "${pair%%:*}")" "$chrome/$link"

      # @import is only honoured before every other rule (bar @charset), so the
      # line goes first — after a leading @charset if the user has one.
      if [[ ! -e "$sheet" ]]; then
        printf '%s\n' "$import" > "$sheet"
      elif ! grep -qF "$IONIX_TB_MARK" "$sheet"; then
        if head -n1 "$sheet" | grep -q '^@charset'; then
          sed -i --follow-symlinks "1a\\$import" "$sheet"
        else
          sed -i --follow-symlinks "1i\\$import" "$sheet"
        fi
      fi
    done

    if ! grep -qF "// $IONIX_TB_MARK begin" "$userjs" 2>/dev/null; then
      # A user.js without a final newline would glue the marker onto its last pref.
      [[ -s "$userjs" && -n "$(tail -c1 "$userjs")" ]] && printf '\n' >> "$userjs"
      {
        printf '// %s begin — managed by ionixtheme, removed on theme switch.\n' "$IONIX_TB_MARK"
        printf '// Loads chrome/userChrome.css, which imports the Ionix theme.\n'
        printf 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
        printf '// %s end\n' "$IONIX_TB_MARK"
      } >> "$userjs"
    fi
  done < <(ionix_thunderbird_profiles)

  if (( ! found )); then
    msg "thunderbird: no profile yet — run Thunderbird once, then switch theme again"
  elif pgrep -x 'thunderbird(-bin)?' &>/dev/null; then
    msg "thunderbird: restart Thunderbird to apply the theme"
  fi
}

ionix_uninstall_thunderbird() {
  local profile chrome userjs pair sheet link

  while IFS= read -r profile; do
    chrome="$profile/chrome"
    userjs="$profile/user.js"

    for pair in "${IONIX_TB_SHEETS[@]}"; do
      sheet="$chrome/${pair%%:*}"
      link="$chrome/${pair#*:}"

      # Only ever our own symlink; a real file of that name is somebody else's.
      [[ -L "$link" ]] && rm -f "$link"

      if [[ -f "$sheet" ]] && grep -qF "$IONIX_TB_MARK" "$sheet"; then
        sed -i --follow-symlinks "/$IONIX_TB_MARK/d" "$sheet"
        # Nothing but whitespace left means the file was ours to begin with.
        grep -q '[^[:space:]]' "$sheet" || rm -f "$sheet"
      fi
    done
    rmdir "$chrome" 2>/dev/null || true

    if [[ -f "$userjs" ]] && grep -qF "// $IONIX_TB_MARK begin" "$userjs"; then
      sed -i --follow-symlinks "\\|^// $IONIX_TB_MARK begin|,\\|^// $IONIX_TB_MARK end|d" "$userjs"
      grep -q '[^[:space:]]' "$userjs" || rm -f "$userjs"
    fi
  done < <(ionix_thunderbird_profiles)
}

# ── Terminal sections ───────────────────────────────────────
#
# These four are what a theme means without a desktop: the server installs
# nothing else. All are plain symlinks that new shells and new btop windows pick
# up; nothing already running is reloaded.

# Remove a link we made; a real file of that name is the user's own.
ionix_unlink() {
  local path="$1" label="$2"
  if [[ -L "$path" ]]; then
    rm -f "$path"
  elif [[ -e "$path" ]]; then
    msg "$label: $(basename "$path") is not our symlink, keeping it"
  fi
}

# fish: syntax colours, fzf, and the Linux console palette (see theme.fish).
# conf.d runs before config.fish, so the user's own settings there still win.
ionix_install_fish() {
  local dest="${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d"
  mkdir -p "$dest"
  ln -sf "$(ionix_theme_file fish theme.fish)" "$dest/ionix-theme.fish"
}

ionix_uninstall_fish() {
  ionix_unlink "${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/ionix-theme.fish" fish
}

# oh-my-posh prompt. config.fish prefers theme.omp.json over the stock
# ionix.omp.json, which is left alone: it is where a prompt of one's own starts.
ionix_install_prompt() {
  local dest="${XDG_CONFIG_HOME:-$HOME/.config}/ionix"
  mkdir -p "$dest"
  ln -sf "$(ionix_theme_file prompt theme.omp.json)" "$dest/theme.omp.json"
}

ionix_uninstall_prompt() {
  ionix_unlink "${XDG_CONFIG_HOME:-$HOME/.config}/ionix/theme.omp.json" prompt
}

# btop. The theme is a file in btop's own themes directory, under one fixed name
# so that btop.conf only ever has to be pointed at it once.
ionix_install_btop() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/btop"
  local conf="$dir/btop.conf"
  mkdir -p "$dir/themes"
  ln -sf "$(ionix_theme_file btop ionix.theme)" "$dir/themes/ionix-styler.theme"

  # btop rewrites btop.conf whole on exit, keeping whatever it read, so one
  # edit sticks. theme_background off lets the terminal's background through.
  if [[ ! -f "$conf" ]]; then
    printf '%s\n' 'color_theme = "ionix-styler"' 'theme_background = False' > "$conf"
  elif ! grep -q '^color_theme = "ionix-styler"$' "$conf"; then
    if grep -q '^color_theme[[:space:]]*=' "$conf"; then
      sed -i --follow-symlinks 's/^color_theme[[:space:]]*=.*/color_theme = "ionix-styler"/' "$conf"
    else
      printf '%s\n' 'color_theme = "ionix-styler"' >> "$conf"
    fi
  fi
}

ionix_uninstall_btop() {
  # btop.conf keeps naming the theme; btop falls back to its default while the
  # link is missing, and the next install puts one back.
  ionix_unlink "${XDG_CONFIG_HOME:-$HOME/.config}/btop/themes/ionix-styler.theme" btop
}

# The console's palette (kmscon, on the server). It lives in
# /etc/kmscon/kmscon.conf and so needs root; ionix-console-theme does the edit.
# A theme switch only gets that far with sudo already unlocked, and says how
# otherwise rather than asking for a password in the middle of it.
ionix_install_tty() {
  local palette
  palette="$(ionix_theme_file tty kmscon.conf)"

  if [[ $EUID -eq 0 ]]; then
    ionix-console-theme "$palette"
  elif sudo -n true &>/dev/null; then
    sudo -n ionix-console-theme "$palette"
  else
    msg "tty: the console palette is system-wide; apply it with: sudo ionix-console-theme $THEME_NAME"
  fi
}

ionix_uninstall_tty() {
  # Replaced, never removed: the console always has some palette.
  :
}

