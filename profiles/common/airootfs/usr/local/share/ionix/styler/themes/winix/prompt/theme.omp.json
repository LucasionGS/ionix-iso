{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#202020",
          "foreground": "#60cdff",
          "leading_diamond": "\ue0c5",
          "options": {
            "macos": "mac"
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} \ue0b1",
          "trailing_diamond": "\ue0b0",
          "type": "os"
        },
        {
          "background": "#202020",
          "foreground": "#e0e0e0",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "#2b2b2b",
          "background_templates": [
            "{{ if eq \"Charging\" .State.String}}#6ccb5f{{ end}}",
            "{{ if eq \"Discharging\" .State.String}}#f7630c{{ end}}",
            "{{ if eq \"Full\" .State.String}}#005a9e{{ end}}"
          ],
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 \ueb2d ",
          "type": "battery"
        },
        {
          "background": "#005a9e",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": " \ue0b1 "
          },
          "style": "powerline",
          "template": " \ue5ff {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#0078d4",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f7630c{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#e81123{{ end }}",
            "{{ if gt .Ahead 0 }}#3a96dd{{ end }}",
            "{{ if gt .Behind 0 }}#60cdff{{ end }}"
          ],
          "foreground": "#1b1b1b",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#1b1b1b{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ffffff{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#6ccb5f",
          "foreground": "#1b1b1b",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "#f7630c",
          "foreground": "#1b1b1b",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf0e7 ",
          "type": "root"
        },
        {
          "background": "#3a96dd",
          "foreground": "#1b1b1b",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf308 {{.Context}} :: {{ if .Namespace}}{{.Namespace}}{{ else}}default{{ end}} ",
          "type": "kubectl"
        },
        {
          "background": "#6ccb5f",
          "background_templates": [
            "{{ if gt .Code 0 }}#e81123{{ end }}"
          ],
          "foreground": "#ffffff",
          "leading_diamond": "<transparent,background>\ue0b0</>",
          "options": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": " \uea6c ",
          "trailing_diamond": "\ue0b0",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "background": "#202020",
          "foreground": "#f7630c",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \uf252 {{ .FormattedMs }} ",
          "type": "executiontime",
          "options": {
            "threshold": 500,
            "style": "roundrock"
          }
        },
        {
          "background": "#2b2b2b",
          "foreground": "#3a96dd",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \ue235 {{ .Full }} ",
          "type": "python",
          "options": {
            "display_mode": "context"
          }
        },
        {
          "background": "#2b2b2b",
          "foreground": "#3a96dd",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \uf308 {{ .Context }} ",
          "type": "docker"
        },
        {
          "background": "#2b2b2b",
          "foreground": "#16c60c",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \udb80\udf5b {{ round .PhysicalPercentUsed .Precision }}% ",
          "type": "sysinfo"
        },
        {
          "background": "#202020",
          "foreground": "#e0e0e0",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \uf073 {{ .CurrentDate | date .Format }} ",
          "type": "time",
          "options": {
            "time_format": "15:04:05"
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#4cc2ff",
          "style": "plain",
          "template": "\u279c ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
