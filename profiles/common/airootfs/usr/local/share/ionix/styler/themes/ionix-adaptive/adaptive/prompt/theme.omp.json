{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "{{bgWindow}}",
          "foreground": "{{accentLight}}",
          "leading_diamond": "\ue0c5",
          "options": {
            "macos": "mac"
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} \ue0b1",
          "trailing_diamond": "\ue0b0",
          "type": "os"
        },
        {
          "background": "{{bgWindow}}",
          "foreground": "{{text}}",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "{{bgCard}}",
          "background_templates": [
            "{{ if eq \"Charging\" .State.String}}{{green}}{{ end}}",
            "{{ if eq \"Discharging\" .State.String}}{{orange}}{{ end}}",
            "{{ if eq \"Full\" .State.String}}{{accentDeep}}{{ end}}"
          ],
          "foreground": "{{textBright}}",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 \ueb2d ",
          "type": "battery"
        },
        {
          "background": "{{accentDeep}}",
          "foreground": "{{textBright}}",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": " \ue0b1 "
          },
          "style": "powerline",
          "template": " \ue5ff {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "{{accent}}",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}{{orange}}{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}{{red}}{{ end }}",
            "{{ if gt .Ahead 0 }}{{ansi6}}{{ end }}",
            "{{ if gt .Behind 0 }}{{accentLight}}{{ end }}"
          ],
          "foreground": "{{bgDeep}}",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}{{bgDeep}}{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}{{textBright}}{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "{{green}}",
          "foreground": "{{bgDeep}}",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "{{orange}}",
          "foreground": "{{bgDeep}}",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf0e7 ",
          "type": "root"
        },
        {
          "background": "{{ansi6}}",
          "foreground": "{{bgDeep}}",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf308 {{.Context}} :: {{ if .Namespace}}{{.Namespace}}{{ else}}default{{ end}} ",
          "type": "kubectl"
        },
        {
          "background": "{{green}}",
          "background_templates": [
            "{{ if gt .Code 0 }}{{red}}{{ end }}"
          ],
          "foreground": "{{textBright}}",
          "leading_diamond": "<transparent,background>\ue0b0</>",
          "options": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": " \uea6c ",
          "trailing_diamond": "\ue0b0",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "background": "{{bgWindow}}",
          "foreground": "{{orange}}",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \uf252 {{ .FormattedMs }} ",
          "type": "executiontime",
          "options": {
            "threshold": 500,
            "style": "roundrock"
          }
        },
        {
          "background": "{{bgCard}}",
          "foreground": "{{cyan}}",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \ue235 {{ .Full }} ",
          "type": "python",
          "options": {
            "display_mode": "context"
          }
        },
        {
          "background": "{{bgCard}}",
          "foreground": "{{ansi6}}",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \uf308 {{ .Context }} ",
          "type": "docker"
        },
        {
          "background": "{{bgCard}}",
          "foreground": "{{ansi10}}",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \udb80\udf5b {{ round .PhysicalPercentUsed .Precision }}% ",
          "type": "sysinfo"
        },
        {
          "background": "{{bgWindow}}",
          "foreground": "{{text}}",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": " \uf073 {{ .CurrentDate | date .Format }} ",
          "type": "time",
          "options": {
            "time_format": "15:04:05"
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "{{accentBright}}",
          "style": "plain",
          "template": "\u279c ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
