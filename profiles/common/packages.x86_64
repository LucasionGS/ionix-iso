# Packages on every Ionix ISO. build.sh appends the variant's own list
# (desktop/packages.x86_64 or server/packages.x86_64) to this one; the kernel is
# in there, since the two variants boot different ones.

# --- Ionix ---
# Ionix's own files (styler, themes, shell config, GRUB theme), built from
# system/ by aur/build-aur.sh. Packaged so an installed system keeps them up to
# date with `yay -Syu`; see system/README.md.
ionix-base-git

# --- Base system ---
base
base-devel
linux-firmware
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
zram-generator

# --- Boot ---
grub
efibootmgr
sbctl
shim-signed
syslinux
memtest86+
memtest86+-efi
edk2-shell
mokutil

# --- Filesystem tools ---
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
f2fs-tools
ntfs-3g
xfsprogs
gptfdisk
parted
squashfs-tools
mtools
lsd

# --- Networking ---
iptables-nft
iwd
openssh
bind
socat

