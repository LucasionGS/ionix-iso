#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: ${0##*/} <0-9>" >&2
}

mode="${1:-}"
if [[ ! "$mode" =~ ^[0-9]$ ]]; then
  usage
  exit 2
fi

command -v hyprctl >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

workspace_json=$(hyprctl -j activeworkspace 2>/dev/null) || exit 0
workspace_id=$(jq -r '.id // empty' <<< "$workspace_json")
monitor_name=$(jq -r '.monitor // empty' <<< "$workspace_json")

[[ -z "$workspace_id" || "$workspace_id" == "null" ]] && exit 0
(( workspace_id < 0 )) && exit 0

clients_json=$(hyprctl -j clients 2>/dev/null) || exit 0
active_address=$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty') || active_address=""

mapfile -t workspace_clients < <(jq -r --argjson ws "$workspace_id" '
  [.[]
    | select(.workspace.id == $ws)
    | select((.mapped // true) == true)
    | select((.hidden // false) == false)
    | select((.pinned // false) == false)]
  | sort_by(.focusHistoryID // 999999)
  | .[].address
' <<< "$clients_json")

(( ${#workspace_clients[@]} == 0 )) && exit 0

has_active=0
for address in "${workspace_clients[@]}"; do
  if [[ "$address" == "$active_address" ]]; then
    has_active=1
    break
  fi
done

if (( has_active == 0 )); then
  active_address="${workspace_clients[0]}"
fi

ordered_clients=("$active_address")
for address in "${workspace_clients[@]}"; do
  [[ "$address" == "$active_address" ]] && continue
  ordered_clients+=("$address")
done

if [[ "$mode" == "0" ]]; then
  for address in "${ordered_clients[@]}"; do
    hyprctl -q dispatch settiled "address:$address" >/dev/null
  done

  hyprctl -q dispatch focuswindow "address:$active_address" >/dev/null
  exit 0
fi

monitors_json=$(hyprctl -j monitors 2>/dev/null) || exit 0
monitor_json=$(jq -c --arg name "$monitor_name" --argjson ws "$workspace_id" '
  (map(select(.name == $name)) + map(select(.activeWorkspace.id == $ws)) | .[0]) // empty
' <<< "$monitors_json")

[[ -z "$monitor_json" || "$monitor_json" == "null" ]] && exit 0

read -r monitor_x monitor_y monitor_width monitor_height reserve_left reserve_top reserve_right reserve_bottom < <(jq -r '
  def n($value): (($value // 0) | floor);
  (.reserved // [0, 0, 0, 0]) as $reserved |
  [
    n(.x),
    n(.y),
    n(.width),
    n(.height),
    n($reserved[0]),
    n($reserved[1]),
    n($reserved[2]),
    n($reserved[3])
  ] | @tsv
' <<< "$monitor_json")

gap=8
usable_x=$((monitor_x + reserve_left + gap))
usable_y=$((monitor_y + reserve_top + gap))
usable_width=$((monitor_width - reserve_left - reserve_right - gap * 2))
usable_height=$((monitor_height - reserve_top - reserve_bottom - gap * 2))

(( usable_width > 0 && usable_height > 0 )) || exit 0

client_count=${#ordered_clients[@]}
columns=3
rows=3

while (( rows * columns < client_count )); do
  if (( columns <= rows )); then
    ((columns++))
  else
    ((rows++))
  fi
done

grid_width=$((usable_width - gap * (columns - 1)))
grid_height=$((usable_height - gap * (rows - 1)))

(( grid_width > 0 && grid_height > 0 )) || exit 0

cell_width=$((grid_width / columns))
cell_height=$((grid_height / rows))
extra_width=$((grid_width - cell_width * columns))
extra_height=$((grid_height - cell_height * rows))

(( cell_width > 0 && cell_height > 0 )) || exit 0

numpad_slot() {
  local key="$1"
  local row=0
  local column=0

  case "$key" in
    7) row=0; column=0 ;;
    8) row=0; column=$(((columns - 1) / 2)) ;;
    9) row=0; column=$((columns - 1)) ;;
    4) row=$(((rows - 1) / 2)); column=0 ;;
    5) row=$(((rows - 1) / 2)); column=$(((columns - 1) / 2)) ;;
    6) row=$(((rows - 1) / 2)); column=$((columns - 1)) ;;
    1) row=$((rows - 1)); column=0 ;;
    2) row=$((rows - 1)); column=$(((columns - 1) / 2)) ;;
    3) row=$((rows - 1)); column=$((columns - 1)) ;;
  esac

  echo $((row * columns + column))
}

slots=()
anchor_slot=$(numpad_slot "$mode")
slots+=("$anchor_slot")

for ((slot = 0; slot < rows * columns; slot++)); do
  [[ "$slot" == "$anchor_slot" ]] && continue
  slots+=("$slot")
done

for index in "${!ordered_clients[@]}"; do
  address="${ordered_clients[$index]}"
  slot="${slots[$index]}"
  row=$((slot / columns))
  column=$((slot % columns))
  width="$cell_width"
  height="$cell_height"
  x=$((usable_x + column * (cell_width + gap)))
  y=$((usable_y + row * (cell_height + gap)))

  if (( column == columns - 1 )); then
    width=$((width + extra_width))
  fi

  if (( row == rows - 1 )); then
    height=$((height + extra_height))
  fi

  hyprctl -q dispatch setfloating "address:$address" >/dev/null
  hyprctl -q dispatch resizewindowpixel "exact $width $height,address:$address" >/dev/null
  hyprctl -q dispatch movewindowpixel "exact $x $y,address:$address" >/dev/null
done

hyprctl -q dispatch focuswindow "address:$active_address" >/dev/null
