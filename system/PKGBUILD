# Maintainer: Lucas <lucasion@hotmail.com>
#
# Builds the Ionix system packages from the working tree; this is what the ISO
# ships. aur/build-aur.sh copies this directory into a scratch build dir first,
# so makepkg never writes into the checkout, which is what makes $startdir safe
# to use here.
#
# It produces the *same package names and version scheme* as the AUR package
# (packaging/aur/PKGBUILD), r<count>.<shorthash> of the last commit that touched
# system/. The installed system drops the [ionix] repo, so pacman then sees
# these as foreign packages and `yay -Syu` picks up later AUR publishes.
#
# The two PKGBUILDs differ only in where the sources come from: keep everything
# else in sync between them. What each package contains is the Makefile's job.

pkgbase=ionix-system-git
pkgname=(ionix-base-git ionix-desktop-git ionix-server-git)
# Placeholder only; pkgver() below overwrites it on every build.
pkgver=r0.0000000
pkgrel=1
pkgdesc="Ionix system files"
arch=('any')
url="https://github.com/LucasionGS/ionix-iso"
license=('GPL-3.0-or-later')
makedepends=('librsvg' 'make')
source=()

# Must match aur-publish.sh's formula exactly, or an ISO build and an AUR publish
# of the same commit would disagree about which one is newer.
#
# build-aur.sh copies this directory without the repository around it, so it
# writes the version to .pkgver beforehand. The git branch below is the fallback
# for running makepkg by hand inside a real checkout.
pkgver() {
    if [[ -f "$startdir/.pkgver" ]]; then
        cat "$startdir/.pkgver"
    elif git -C "$startdir" rev-parse HEAD >/dev/null 2>&1; then
        printf "r%s.%s" \
            "$(git -C "$startdir" rev-list --count HEAD -- .)" \
            "$(git -C "$startdir" log -1 --format=%h -- .)"
    else
        printf '%s' "$pkgver"
    fi
}

build() {
    make -C "$startdir" BUILDDIR="$srcdir/build" build
}

# Every regular file under /etc is a config file: pacman keeps a local edit and
# writes the new version beside it as .pacnew.
_etc_backup() {
    mapfile -t backup < <(cd "$pkgdir" && find etc -type f 2>/dev/null | LC_ALL=C sort)
}

package_ionix-base-git() {
    pkgdesc="Ionix system files shared by the desktop and the server: styler and themes, shell config, GRUB theme (git)"
    depends=('bash' 'util-linux')
    optdepends=(
        'fish: the shell the Ionix config is written for'
        'oh-my-posh: the themed prompt'
        'btop: themed by the styler'
        'kmscon: the themed console (ionix-console-theme)'
        'grub: the Ionix boot menu theme'
    )
    provides=('ionix-base')
    conflicts=('ionix-base')

    make -C "$startdir" DESTDIR="$pkgdir" BUILDDIR="$srcdir/build" install-base
    _etc_backup
}

package_ionix-desktop-git() {
    pkgdesc="Ionix desktop: Hyprland defaults, session scripts, login modes, wallpaper (git)"
    depends=('ionix-base' 'hyprland' 'python')
    optdepends=(
        'ionix-quickshell-git: the Ionix bar, lock screen and greeter'
        'greetd: the graphical login (ionix-login-mode greeter)'
        'fprintd: fingerprint login (ionix-fingerprint)'
        'yay: optional software bundles from the AUR (ionix-extras)'
        'matugen: wallpaper-adaptive themes'
        'socat: Hyprland event sounds (ionix-sounds)'
        'ffmpeg: m4a and aac event sounds (ionix-sounds)'
    )
    provides=('ionix-desktop')
    conflicts=('ionix-desktop' 'ionix-server')

    make -C "$startdir" DESTDIR="$pkgdir" BUILDDIR="$srcdir/build" install-desktop
    _etc_backup
}

package_ionix-server-git() {
    pkgdesc="Ionix server: first-boot firewall and snapshot setup (git)"
    depends=('ionix-base')
    optdepends=(
        'ufw: the firewall ionix-server-firstboot sets up'
        'snapper: the "Fresh install" snapshot ionix-server-firstboot takes'
    )
    provides=('ionix-server')
    conflicts=('ionix-server' 'ionix-desktop')

    make -C "$startdir" DESTDIR="$pkgdir" BUILDDIR="$srcdir/build" install-server
    _etc_backup
}
